Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Primitive", " ", "for", " ", "drawing", " ", "wBa", " ", "Bratteli", " ", 
    "diagram"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"BratteliLevels", "[", 
     RowBox[{"p_", ",", "q_", ",", "d_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"{", "}"}], ",", "i"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "p"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"IntegerPartitions", "[", 
          RowBox[{"i", ",", "d"}], "]"}]}], "}"}]}], "]"}], "~", "Join", "~", 
     
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", "y", ",", 
             RowBox[{"p", "+", "i"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", 
             RowBox[{"Min", "[", 
              RowBox[{"p", ",", "i"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"IntegerPartitions", "[", 
              RowBox[{
               RowBox[{"p", "-", "k"}], ",", "d"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", 
             RowBox[{"IntegerPartitions", "[", 
              RowBox[{
               RowBox[{"i", "-", "k"}], ",", 
               RowBox[{"d", "-", 
                RowBox[{"Length", "@", "x"}]}]}], "]"}]}], "}"}]}], "]"}], 
         ",", "2"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "q"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Contains", "[", 
