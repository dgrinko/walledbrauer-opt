  Cell[CellGroupData[
    {Cell["2. Diagram contractions and input-class fidelities", "Section"],
     Cell["Contract removes an output wire, multiplying by d whenever the \
contraction closes a loop. TraceDiagMat evaluates a diagram on a \
computational-basis input/output string. These operations keep the LP exact; \
no full d\:2074 \[Times] d\:2074 matrices are constructed.", "Text"],
     Cell[BoxData[RowBox[{RowBox[{RowBox[{"ContractDiagOne", "[",
             RowBox[{"diag__", ",", RowBox[{"{", RowBox[{"l_", ",", "d_"}],
                 "}"}]}], "]"}], ":=", RowBox[{"Module", "[",
             RowBox[{RowBox[{"{", RowBox[{"new", ",", "data"}], "}"}], ",",
               RowBox[{RowBox[{"data", "=", RowBox[{"diag", "/.",
                     "\[VeryThinSpace]", RowBox[{"B", "\[Rule]",
                       "List"}]}]}], RowBox[{";", "\[IndentingNewLine]"}],
                 RowBox[{"new", "=", RowBox[{"Sort", "[", RowBox[{"Flatten",
                       "[", RowBox[{"Table", "[", RowBox[{RowBox[{"If", "[",
                          RowBox[{RowBox[{RowBox[{RowBox[{"data",
                          "\[LeftDoubleBracket]", "i",
                          "\[RightDoubleBracket]"}], "\[Intersection]",
                          RowBox[{"{", RowBox[{RowBox[{"-", "l"}], ",",
                          "l"}], "}"}]}], "\[NotEqual]", RowBox[{"{",
                          "}"}]}], ",", RowBox[{"Complement", "[", RowBox[
                          {RowBox[{"data", "\[LeftDoubleBracket]", "i",
                          "\[RightDoubleBracket]"}], ",", RowBox[{"{", RowBox[
                          {RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}],
                          ",", RowBox[{"{", "}"}]}], "]"}], ",", RowBox[
                          {"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length",
                          "[", "data", "]"}]}], "}"}]}], "]"}], "]"}],
                     "]"}]}], RowBox[{";", "\[IndentingNewLine]"}],
                 RowBox[{"If", "[", RowBox[{RowBox[{"new", "\[Equal]",
                       RowBox[{"{", "}"}]}], ",", RowBox[{"d", " ", RowBox[
                        {"B", "[", RowBox[{"Sequence", "@@", RowBox[{"Sort",
                          "[", RowBox[{"Table", "[", RowBox[{RowBox[{"If",
                          "[", RowBox[{RowBox[{RowBox[{RowBox[{"data",
                          "\[LeftDoubleBracket]", "i",
                          "\[RightDoubleBracket]"}], "\[Intersection]",
                          RowBox[{"{", RowBox[{RowBox[{"-", "l"}], ",",
                          "l"}], "}"}]}], "\[NotEqual]", RowBox[{"{",
                          "}"}]}], ",", "Nothing", ",", RowBox[{"data",
                          "\[LeftDoubleBracket]", "i",
                          "\[RightDoubleBracket]"}]}], "]"}], ",", RowBox[
                          {"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length",
                          "[", "data", "]"}]}], "}"}]}], "]"}], "]"}]}],
                         "]"}]}], ",", RowBox[{"B", "[", RowBox[{"Sequence",
                         "@@", RowBox[{"Sort", "[", RowBox[{"Join", "[",
                          RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"If",
                          "[", RowBox[{RowBox[{RowBox[{RowBox[{"data",
                          "\[LeftDoubleBracket]", "i",
                          "\[RightDoubleBracket]"}], "\[Intersection]",
                          RowBox[{"{", RowBox[{RowBox[{"-", "l"}], ",",
                          "l"}], "}"}]}], "\[NotEqual]", RowBox[{"{",
                          "}"}]}], ",", "Nothing", ",", RowBox[{"data",
                          "\[LeftDoubleBracket]", "i",
                          "\[RightDoubleBracket]"}]}], "]"}], ",", RowBox[
                          {"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length",
                          "[", "data", "]"}]}], "}"}]}], "]"}], ",", RowBox[
                          {"{", "new", "}"}]}], "]"}], "]"}]}], "]"}]}],
                   "]"}]}]}], "]"}]}], RowBox[{";", "\[IndentingNewLine]"}],
         RowBox[{RowBox[{"ContractDiag", "[", RowBox[{"x_", ",", RowBox[
                {"{", RowBox[{"l_", ",", "d_"}], "}"}]}], "]"}], ":=",
           RowBox[{"x", "/.", "\[VeryThinSpace]", RowBox[{RowBox[
                {"B", "[", "lst__", "]"}], "\[RuleDelayed]", RowBox[
                {"ContractDiagOne", "[", RowBox[{RowBox[{"{", "lst", "}"}],
                   ",", RowBox[{"{", RowBox[{"l", ",", "d"}], "}"}]}],
                 "]"}]}]}]}], RowBox[{";", "\[IndentingNewLine]"}],
         RowBox[{RowBox[{"Contract", "[", RowBox[{"x_", ",", "lst_List", ",",
