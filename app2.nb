  Cell[CellGroupData[
    {Cell["5. Verify an explicit solution for the whole family", "Section"],
     Cell["This section uses its own unassigned symbol dimensionParameter and \
rebuilds the generic LP. It does not depend on changing the numerical value \
of d or reconstructing a previously evaluated optimization call. The formulas \
use the ordered basis of primitive_3_1.txt; d = 3 is checked in the separate \
nine-path basis.", "Text"], Cell[CellGroupData[
       {Cell[BoxData[RowBox[{RowBox[{"Clear", "[", "dimensionParameter",
              "]"}], RowBox[{";", "\[IndentingNewLine]"}],
            RowBox[{"symbolicModel", "=", RowBox[{"majorityLP", "[",
                "dimensionParameter", "]"}]}], RowBox[
             {";", "\[IndentingNewLine]"}], RowBox[{"genericSolution", "=",
              RowBox[{"Thread", "[", RowBox[{RowBox[{"symbolicModel", "[",
                    "\"Variables\"", "]"}], "\[Rule]", RowBox[{"{",
                    RowBox[{FractionBox["8", "9"], ",", "0", ",", "0", ",",
                      "0", ",", "0", ",", FractionBox[RowBox[
                        {"dimensionParameter", "+", "2"}], "3"], ",", "0",
                      ",", "0", ",", FractionBox[RowBox[{"2", " ", RowBox[
                          {"(", RowBox[{"dimensionParameter", "+", "1"}],
                          ")"}]}], "3"], ",", FractionBox[RowBox[{"2", " ",
                         RowBox[{"(", RowBox[{"dimensionParameter", "+",
                          "1"}], ")"}]}], "3"], ",", FractionBox[RowBox[
                        {"dimensionParameter", "-", "2"}], "3"]}], "}"}]}],
                "]"}]}], RowBox[{";", "\[IndentingNewLine]"}],
            RowBox[{"symbolicVerification", "=", RowBox[{"Association", "[",
                RowBox[{RowBox[{"\"AllConstraintsForDAtLeast4\"", "\[Rule]",
                    RowBox[{"FullSimplify", "[", RowBox[{RowBox[{"And", "@@",
                          RowBox[{"(", RowBox[{RowBox[{"symbolicModel", "[",
                          "\"Constraints\"", "]"}], "/.", "\[VeryThinSpace]",
                          "genericSolution"}], ")"}]}], ",", RowBox[
                         {"dimensionParameter", "\[GreaterEqual]", "4"}]}],
                      "]"}]}], ",", RowBox[{"\"ClassFidelities\"", "\[Rule]",
                    RowBox[{"FullSimplify", "[", RowBox[{RowBox[{RowBox[
                          {"symbolicModel", "[", "\"ClassFidelities\"",
                          "]"}], "/.", "\[VeryThinSpace]",
                          "genericSolution"}], ",", RowBox[
                         {"dimensionParameter", "\[GreaterEqual]", "4"}]}],
                      "]"}]}]}], "]"}]}], RowBox[
             {";", "\[IndentingNewLine]"}], "symbolicVerification"}]],
         "Input", CellTags -> "app2-symbolic-verification"],
        Cell[BoxData[RowBox[{"\[LeftAssociation]",
            RowBox[{RowBox[{"\"AllConstraintsForDAtLeast4\"", "\[Rule]",
                "True"}], ",", RowBox[{"\"ClassFidelities\"", "\[Rule]",
                RowBox[{"{", RowBox[{"1", ",", FractionBox["8", "9"], ",",
                    "1"}], "}"}]}]}], "\[RightAssociation]"}]], "Output"]},
       Open]], Cell[CellGroupData[
       {Cell[BoxData[RowBox[{RowBox[{"dimension3Model", "=",
              RowBox[{"majorityLP", "[", "3", "]"}]}],
            RowBox[{";", "\[IndentingNewLine]"}],
            RowBox[{"dimension3Solution", "=", RowBox[{"Thread", "[",
                RowBox[{RowBox[{"dimension3Model", "[", "\"Variables\"",
                    "]"}], "\[Rule]", RowBox[{"{", RowBox[{FractionBox["8",
                       "9"], ",", "0", ",", "0", ",", "0", ",", FractionBox[
                       "5", "3"], ",", "0", ",", "0", ",", FractionBox["8",
                       "3"], ",", FractionBox["8", "3"], ",", FractionBox[
                       "1", "3"]}], "}"}]}], "]"}]}],
            RowBox[{";", "\[IndentingNewLine]"}],
            RowBox[{"dimension3Verification", "=", RowBox[{"Association",
                "[", RowBox[{RowBox[{"\"AllConstraintsAtD3\"", "\[Rule]",
                    RowBox[{"And", "@@", RowBox[{"(", RowBox[{RowBox[
                          {"dimension3Model", "[", "\"Constraints\"", "]"}],
                          "/.", "\[VeryThinSpace]", "dimension3Solution"}],
                        ")"}]}]}], ",", RowBox[{"\"ClassFidelities\"",
                    "\[Rule]", RowBox[{"(", RowBox[{RowBox[
                         {"dimension3Model", "[", "\"ClassFidelities\"",
                          "]"}], "/.", "\[VeryThinSpace]",
                        "dimension3Solution"}], ")"}]}]}], "]"}]}],
            RowBox[{";", "\[IndentingNewLine]"}],
            "dimension3Verification"}]], "Input", CellTags ->
          "app2-d3-verification"], Cell[BoxData[RowBox[{"\[LeftAssociation]",
            RowBox[{RowBox[{"\"AllConstraintsAtD3\"", "\[Rule]", "True"}],
              ",", RowBox[{"\"ClassFidelities\"", "\[Rule]", RowBox[
                 {"{", RowBox[{"1", ",", FractionBox["8", "9"], ",", "1"}],
                  "}"}]}]}], "\[RightAssociation]"}]], "Output"]}, Open]],
     Cell["Both checks should return True, with class fidelities {1, 8/9, 1}. \
They establish feasibility of this explicit family for every supported \
dimension. The generic symbolic check concerns d \[GreaterEqual] 4; the d = 3 \
check covers the exceptional path basis. Feasibility alone is a lower-bound \
certificate; the analytic optimality statement is given in Section 7.2 of the \
paper.", "Text"]}, Open]],
  Cell[CellGroupData[{Cell["6. Independent numerical dimensions", "Section"],
     Cell["Rebuild and solve the LP independently at d = 3, 4 and 9. Each row \
should report 8/9 and True. These are exact rational computations and \
exercise both database branches.", "Text"],
     Cell[CellGroupData[
       {Cell[BoxData[RowBox[{RowBox[{"dimensionChecks", "=", RowBox[{"Table",
                "[", RowBox[{RowBox[{"Module", "[", RowBox[{RowBox[{"{",
                        RowBox[{"model", ",", "solution"}], "}"}], ",",
                      RowBox[{RowBox[{"model", "=", RowBox[{"majorityLP",
                          "[", "testDimension", "]"}]}], RowBox[{";",
                          "\[IndentingNewLine]"}], RowBox[{"solution", "=",
                          RowBox[{"majoritySolve", "[", "model", "]"}]}],
                        RowBox[{";", "\[IndentingNewLine]"}], RowBox[
                         {"{", RowBox[{"testDimension", ",", RowBox[{"fid",
                          "/.", "\[VeryThinSpace]", "solution"}], ",",
                          RowBox[{"And", "@@", RowBox[{"(", RowBox[{RowBox[
                          {"model", "[", "\"Constraints\"", "]"}], "/.",
                          "\[VeryThinSpace]", "solution"}], ")"}]}]}],
                          "}"}]}]}], "]"}], ",", RowBox[{"{", RowBox[
                     {"testDimension", ",", RowBox[{"{", RowBox[{"3", ",",
                          "4", ",", "9"}], "}"}]}], "}"}]}], "]"}]}],
            RowBox[{";", "\[IndentingNewLine]"}], RowBox[{"Grid", "[",
              RowBox[{RowBox[{"Prepend", "[", RowBox[{"dimensionChecks", ",",
                    RowBox[{"{", RowBox[{"\"Dimension\"", ",", "\"Optimum\"",
                        ",", "\"All constraints satisfied\""}], "}"}]}],
                  "]"}], ",", RowBox[{"Frame", "\[Rule]", "All"}]}],
              "]"}]}]], "Input", CellTags -> "app2-dimension-checks"],
        Cell[BoxData[TagBox[GridBox[{{"\"Dimension\"", "\"Optimum\"",
              "\"All constraints satisfied\""}, {"3", FractionBox["8", "9"],
              "True"}, {"4", FractionBox["8", "9"], "True"},
