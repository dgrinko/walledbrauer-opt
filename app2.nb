            RowBox[{";", "\[IndentingNewLine]"}], RowBox[{"majoritySummary",
              "=", RowBox[{"Association", "[", RowBox[{RowBox[
                   {"\"Dimension\"", "\[Rule]", "d"}], ",", RowBox[
                   {"\"NumberOfPaths\"", "\[Rule]", RowBox[{"Length", "[",
