                    "\[Rule]", RowBox[{"(", RowBox[{RowBox[{"numericModel",
                          "[", "\"ClassFidelities\"", "]"}], "/.",
                        "\[VeryThinSpace]", "lin"}], ")"}]}], ",",
                  RowBox[{"\"AllConstraintsSatisfied\"", "\[Rule]",
                    RowBox[{"And", "@@", RowBox[{"(", RowBox[{RowBox[
