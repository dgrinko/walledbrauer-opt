           RowBox[{"Times", "@@", RowBox[{RowBox[{"(", RowBox[
                  {TemplateBox[{RowBox[{RowBox[{"ket",
                         "\[LeftDoubleBracket]", RowBox[{"Abs", "[", RowBox[
                          {"#1", "\[LeftDoubleBracket]", "1",
                          "\[RightDoubleBracket]"}], "]"}],
                         "\[RightDoubleBracket]"}], ",", RowBox[{"ket",
