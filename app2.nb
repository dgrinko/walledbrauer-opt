                          "/.", "\[VeryThinSpace]", "lin"}], ")"}]}]}]}],
                "]"}]}], RowBox[{";", "\[IndentingNewLine]"}],
            "majoritySummary"}]], "Input", CellTags -> "app2-summary"],
        Cell[BoxData[RowBox[{"\[LeftAssociation]",
