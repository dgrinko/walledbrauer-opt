                     "}"}], ",", "ket"}], "]"}]}]}]}],
         RowBox[{";", "\[IndentingNewLine]"}]}]], "Input",
      CellTags -> "app2-class-trace"]}, Open]],
  Cell[CellGroupData[{Cell["3. Construct the exact LP", "Section"],
     Cell["For the three input classes 000, 001 and 012, the accepted outputs \
are respectively 0, 0 and any of 0, 1, 2. The variables a[i] are the \
nonnegative primitive-idempotent coefficients of the Choi operator; fid is \
their common lower bound on success probability. Trace preservation is \
imposed by matching diagram coefficients.", "Text"],
     Cell["Input-permutation symmetry equates weights of paths with the same \
last two vertices. Computing these groups from the path labels reproduces the \
dimension-dependent symmetry constraints without assuming a fixed path order. \
majorityLP accepts an integer d \[GreaterEqual] 3 or an unassigned symbol for \
the generic family; it returns the model without solving it.", "Text"],
     Cell[BoxData[RowBox[{RowBox[{StyleBox[RowBox[{"majorityLP", "::",
              "dimension"}], "MessageName"], "=", "\"Dimension `1` must be an \
integer at least 3, or an unassigned symbol for the generic family.\""}],
         RowBox[{";", "\[IndentingNewLine]"}],
         RowBox[{RowBox[{"majorityLP", "[", "dim_", "]"}], ":=",
           RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"paths", ",",
                   "idempotents", ",", "weights", ",", "choi", ",",
                   "acceptedOutputs", ",", "inputClasses", ",", "inout", ",",
                   "classFidelities", ",", "positivity", ",", "traceRaw",
                   ",", "diagrams", ",", "traceConstraints", ",",
                   "symmetryGroups", ",", "symmetryConstraints", ",",
                   "constraints", ",", "variables"}], "}"}], ",", RowBox[
                {RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"!", RowBox[
                          {"(", RowBox[{RowBox[{"MatchQ", "[", RowBox[{"dim",
                          ",", "_Symbol"}], "]"}], "&&", RowBox[{"!", RowBox[
                          {"NumericQ", "[", "dim", "]"}]}]}], ")"}]}], "&&",
                       RowBox[{"!", RowBox[{"(", RowBox[{RowBox[{"IntegerQ",
                          "[", "dim", "]"}], "&&", RowBox[{"dim",
                          "\[GreaterEqual]", "3"}]}], ")"}]}]}], ",",
                     RowBox[{RowBox[{"Message", "[", RowBox[{StyleBox[RowBox[
                          {"majorityLP", "::", "dimension"}], "MessageName"],
                          ",", "dim"}], "]"}], RowBox[{";",
                         "\[IndentingNewLine]"}], RowBox[{"Return", "[",
                         "$Failed", "]"}]}]}], "]"}], RowBox[{";",
                   "\[IndentingNewLine]"}], RowBox[{RowBox[{"{", RowBox[
                      {"paths", ",", "idempotents"}], "}"}], "=",
                   RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"dim", "===",
                          "3"}], ",", "idempotentData3", ",",
                         "idempotentDataGeneric"}], "]"}], "/.",
                     "\[VeryThinSpace]", RowBox[{"z", "\[Rule]", "dim"}]}]}],
                 RowBox[{";", "\[IndentingNewLine]"}], RowBox[{"weights",
                   "=", RowBox[{"Array", "[", RowBox[{"a", ",", RowBox[
                        {"Length", "[", "idempotents", "]"}]}], "]"}]}],
                 RowBox[{";", "\[IndentingNewLine]"}], RowBox[{"choi", "=",
                   RowBox[{"weights", ".", "idempotents"}]}], RowBox[
                  {";", "\[IndentingNewLine]"}], RowBox[{"acceptedOutputs",
                   "=", RowBox[{"Association", "[", RowBox[{RowBox[
                        {RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}],
                          "}"}], "\[Rule]", RowBox[{"{", RowBox[{"{", "0",
                          "}"}], "}"}]}], ",", RowBox[{RowBox[{"{", RowBox[
                          {"0", ",", "0", ",", "1"}], "}"}], "\[Rule]",
                         RowBox[{"{", RowBox[{"{", "0", "}"}], "}"}]}], ",",
                       RowBox[{RowBox[{"{", RowBox[{"0", ",", "1", ",",
                          "2"}], "}"}], "\[Rule]", RowBox[{"{", RowBox[
                          {RowBox[{"{", "0", "}"}], ",", RowBox[{"{", "1",
                          "}"}], ",", RowBox[{"{", "2", "}"}]}], "}"}]}]}],
                     "]"}]}], RowBox[{";", "\[IndentingNewLine]"}],
                 RowBox[{"inputClasses", "=", RowBox[{"Keys", "[",
                     "acceptedOutputs", "]"}]}], RowBox[{";",
                   "\[IndentingNewLine]"}], RowBox[{"inout", "=",
                   RowBox[{"Table", "[", RowBox[{RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"Join", "[", RowBox[{"input", ",", "#1"}],
                          "]"}], "&"}], ")"}], "/@", RowBox[
                          {"acceptedOutputs", "[", "input", "]"}]}], ",",
                       RowBox[{"{", RowBox[{"input", ",", "inputClasses"}],
                         "}"}]}], "]"}]}], RowBox[{";",
                   "\[IndentingNewLine]"}], RowBox[{"classFidelities", "=",
                   RowBox[{"Together", "[", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"Total", "[", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"TraceDiagMat", "[", RowBox[{"choi", ",",
                          "#1"}], "]"}], "&"}], ")"}], "/@", "#1"}], "]"}],
                          "&"}], ")"}], "/@", "inout"}], "]"}]}],
                 RowBox[{";", "\[IndentingNewLine]"}], RowBox[{"positivity",
                   "=", RowBox[{"Thread", "[", RowBox[{"weights",
                       "\[GreaterEqual]", "0"}], "]"}]}], RowBox[
                  {";", "\[IndentingNewLine]"}], RowBox[{"traceRaw", "=",
                   RowBox[{"Expand", "[", RowBox[{RowBox[{"Contract", "[",
                         RowBox[{"choi", ",", RowBox[{"{", "4", "}"}], ",",
                          "dim"}], "]"}], "-", RowBox[{"B", "[", RowBox[
                          {RowBox[{"{", RowBox[{RowBox[{"-", "3"}], ",",
                          "3"}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[
                          {"-", "2"}], ",", "2"}], "}"}], ",", RowBox[{"{",
                          RowBox[{RowBox[{"-", "1"}], ",", "1"}], "}"}]}],
                         "]"}]}], "]"}]}], RowBox[{";",
                   "\[IndentingNewLine]"}], RowBox[{"diagrams", "=",
                   RowBox[{"DeleteDuplicates", "[", RowBox[{"Cases", "[",
                       RowBox[{"traceRaw", ",", "_B", ",", "\[Infinity]"}],
                       "]"}], "]"}]}], RowBox[{";", "\[IndentingNewLine]"}],
                 RowBox[{"traceConstraints", "=", RowBox[{RowBox[{"(",
                       RowBox[{RowBox[{RowBox[{"Together", "[", RowBox[
                          {"Coefficient", "[", RowBox[{"traceRaw", ",",
                          "#1"}], "]"}], "]"}], "\[Equal]", "0"}], "&"}],
                       ")"}], "/@", "diagrams"}]}], RowBox[{";",
                   "\[IndentingNewLine]"}], RowBox[{"symmetryGroups", "=",
                   RowBox[{"Select", "[", RowBox[{RowBox[{"GatherBy", "[",
                         RowBox[{RowBox[{"Range", "[", RowBox[{"Length", "[",
                          "paths", "]"}], "]"}], ",", RowBox[{RowBox[{"Take",
                          "[", RowBox[{RowBox[{"paths",
                          "\[LeftDoubleBracket]", "#1",
                          "\[RightDoubleBracket]"}], ",", RowBox[{"-",
                          "2"}]}], "]"}], "&"}]}], "]"}], ",", RowBox[
                        {RowBox[{RowBox[{"Length", "[", "#1", "]"}], ">",
                          "1"}], "&"}]}], "]"}]}], RowBox[{";",
                   "\[IndentingNewLine]"}], RowBox[{"symmetryConstraints",
                   "=", RowBox[{"Flatten", "[", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"Thread", "[", RowBox[{RowBox[{"Rest",
                          "[", RowBox[{"weights", "\[LeftDoubleBracket]",
                          "#1", "\[RightDoubleBracket]"}], "]"}], "\[Equal]",
                          RowBox[{"First", "[", RowBox[{"weights",
                          "\[LeftDoubleBracket]", "#1",
                          "\[RightDoubleBracket]"}], "]"}]}], "]"}], "&"}],
                         ")"}], "/@", "symmetryGroups"}], "]"}]}],
                 RowBox[{";", "\[IndentingNewLine]"}], RowBox[{"constraints",
                   "=", RowBox[{"Join", "[", RowBox[{"positivity", ",",
                       "traceConstraints", ",", RowBox[{"Thread", "[",
                         RowBox[{"classFidelities", "\[GreaterEqual]",
                          "fid"}], "]"}], ",", "symmetryConstraints"}],
                     "]"}]}], RowBox[{";", "\[IndentingNewLine]"}],
                 RowBox[{"variables", "=", RowBox[{"Prepend", "[", RowBox[
                      {"weights", ",", "fid"}], "]"}]}], RowBox[
                  {";", "\[IndentingNewLine]"}], RowBox[{"Association", "[",
                   RowBox[{RowBox[{"\"Dimension\"", "\[Rule]", "dim"}], ",",
                     RowBox[{"\"Paths\"", "\[Rule]", "paths"}], ",",
                     RowBox[{"\"Weights\"", "\[Rule]", "weights"}], ",",
                     RowBox[{"\"ClassFidelities\"", "\[Rule]",
                       "classFidelities"}], ",", RowBox[
                      {"\"TraceConstraints\"", "\[Rule]",
                       "traceConstraints"}], ",", RowBox[
                      {"\"SymmetryGroups\"", "\[Rule]", "symmetryGroups"}],
                     ",", RowBox[{"\"SymmetryConstraints\"", "\[Rule]",
                       "symmetryConstraints"}], ",", RowBox[
                      {"\"Constraints\"", "\[Rule]", "constraints"}], ",",
                     RowBox[{"\"Variables\"", "\[Rule]", "variables"}]}],
                   "]"}]}]}], "]"}]}], RowBox[{";", "\[IndentingNewLine]"}],
         RowBox[{RowBox[{"majoritySolve", "[", "model_Association", "]"}],
           ":=", RowBox[{"LinearOptimization", "[",
             RowBox[{RowBox[{"-", "fid"}], ",", RowBox[{"model", "[",
                 "\"Constraints\"", "]"}], ",", RowBox[{"model", "[",
                 "\"Variables\"", "]"}]}], "]"}]}],
         RowBox[{";", "\[IndentingNewLine]"}]}]], "Input",
      CellTags -> "app2-model-builder"]}, Open]],
  Cell[CellGroupData[{Cell["4. Solve at the selected dimension", "Section"],
     Cell["The summary should report an optimum of 8/9 and True for \
feasibility. The optimizer may choose any point on the optimal face, so its \
coefficients and individual class fidelities need not equal the particular \
closed-form solution below.", "Text"],
     Cell[CellGroupData[
       {Cell[BoxData[RowBox[{RowBox[{"numericModel", "=",
              RowBox[{"majorityLP", "[", "d", "]"}]}],
            RowBox[{";", "\[IndentingNewLine]"}], RowBox[{"If", "[",
              RowBox[{RowBox[{"numericModel", "===", "$Failed"}], ",",
                RowBox[{"Abort", "[", "]"}]}], "]"}],
            RowBox[{";", "\[IndentingNewLine]"}], RowBox[{"lin", "=",
