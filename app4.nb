(* Wolfram Notebook File *)

Notebook[{Cell["Sequential unitary transposition and inversion", "Title"],
  Cell["Application 4 | Section 7.4 and Table 2", "Subtitle"],
  Cell["Run this notebook from the top in a fresh kernel. The default is three calls to a \
three-dimensional unitary, with target U transpose. The shared implementation in app4_tools.wl \
loads the shipped matrix units, constructs the symmetry-reduced comb SDP, and reports the objective \
together with feasibility checks.", "Text"], Cell["1. Choose the task", "Section"],
  Cell["Use task = \"transpose\" for wall (p,q) = (n,1), or \"inverse\" for (p,q) = (n+1,0). Set n \
to the number of calls and d to the unitary dimension. The shipped data cover the Table 2 cases n = \
1,...,4 and d = 2,3; larger cases can require substantially more time and memory.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[",
          RowBox[{"{", RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"app4_tools.wl\""}],
            "}"}], "]"}], "]"}], ";", "", RowBox[{"task", "=", "\"transpose\""}], ";", "",
      RowBox[{"n", "=", "3"}], ";", "", RowBox[{"d", "=", "3"}], ";", "",
      RowBox[{"verifyExactAnsatz", "=", "False"}], ";", ""}]], "Input"],
  Cell["2. Solve and inspect the residuals", "Section"], Cell["Normalization: the comb uses \
unnormalized channel Choi matrices. Its scalar base is C0 = 1, so Tr[C] = d^(n+1). The trace-one \
statement in equation (171) does not match this convention or Table 2; do not impose Tr[C] = 1 on \
this SDP. The objective retains the factor 1/d^2 in the paper's average channel fidelity.",
   "Text"],
  Cell[BoxData[RowBox[{RowBox[{"result", "=", RowBox[{"App4Solve", "[",
          RowBox[{"task", ",", "n", ",", "d", ",", RowBox[{"\"VerifyExactAnsatz\"", "",
              "verifyExactAnsatz"}]}], "]"}]}], ";", "",
      RowBox[{"If", "[", RowBox[{RowBox[{"AssociationQ", "[", "result", "]"}], ",",
          RowBox[{"Grid", "[", RowBox[{RowBox[{"List", "@@@", RowBox[{"Normal", "[", "result",
                  "]"}]}], ",", RowBox[{"Alignment", "", "Left"}], ",", RowBox[{"Frame", "",
                "All"}]}], "]"}], ",", "result"}], "]"}]}]], "Input"],
  Cell["Expected default: fidelity 0.626597 (rounded), with 305 real variables and 154 scalar \
equalities. The result includes the maximum equality residual, the minimum PSD-block eigenvalue, \
and a 10^-7 feasibility flag. Table2Agreement uses a 5 x 10^-7 rounding tolerance because the table \
prints six decimals. Read any solver messages as well as these diagnostics; a numerical agreement \
is not an exact proof of optimality.", "Text"], Cell["Table 2 reference values", "Subsection"],
  Cell[BoxData[TagBox[GridBox[{{"\"calls n\"", "\"transpose d=2\"", "\"transpose d=3\"",
        "\"inverse d=2\"", "\"inverse d=3\""}, {"1", "\"0.500000\"", "\"0.222222\"",
        "\"0.500000\"", "\"0.222222\""}, {"2", "\"0.750000\"", "\"0.407407\"", "\"0.750000\"",
        "\"0.333333\""}, {"3", "\"0.933013\"", "\"0.626597\"", "\"0.933013\"", "\"0.444444\""},
       {"4", "\"1.000000\"", "\"0.799250\"", "\"1.000000\"", "\"0.555556\""}},
      GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False,
      GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}},
      GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
      GridBoxSpacings -> {"Columns" -> {{1}}, "Rows" -> {{0.7}}}], "Grid"]], "Text",
   ShowStringCharacters -> False], Cell["3. Optional exact expansion and exact certificate",
   "Section"], Cell["Set verifyExactAnsatz = True and rerun the solver to construct the independent \
exact matrix-unit expansion and compare every coefficient with the numerical ansatz. This check is \
useful for small cases. It does not change the \
optimization problem. Symbolic expansion can dominate runtime at n = 4, so it is disabled for \
normal numerical runs.", "Text"], Cell["For n = 4, d = 2, guess_magic_4_1_2.nb is a separate exact \
certificate with fidelity 1. It initializes itself and checks exact constraints, PSD blocks, trace \
and fidelity.", "Text"]}, WindowSize -> {1100, 850},
 StyleDefinitions -> "Default.nb"]

(* End of Notebook Content *)
