       RowBox[{"p", ",", "q"}], "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"SortB", "[", 
          RowBox[{"B", "[", 
           RowBox[{"Sequence", "@@", "#"}], "]"}], "]"}], ")"}], "&"}], "/@", 
       
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"FlipPair", "[", 
           RowBox[{"#", ",", "p"}], "]"}], "&"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"FoldList", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ReplacePart", "[", 
                RowBox[{"#1", ",", 
                 RowBox[{"#2", "->", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "#2"}], ",", 
                    RowBox[{"#1", "[", 
                    RowBox[{"[", "#2", "]"}], "]"}]}], "}"}]}]}], "]"}], 
               "&"}], ",", "#", ",", 
              RowBox[{"Range", "[", 
               RowBox[{"p", "+", "q"}], "]"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "&"}], "/@", 
