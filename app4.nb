        RowBox[{"{", 
         RowBox[{
          RowBox[{"B", "@@", 
           RowBox[{"SortB", "@", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"If", "[", 
