Notebook[{
Cell["Deciding the principal eigenvalue (Sect. 7.1, Example 7.1, eqs. (152)-(153), Fig. 5) for d = 2, k = 2 and n = 1..8 copies. The traces Tr[rho^(x)n P] are taken from the Sage output pasted in pData; traceNew computes the same traces from idempotents/metadata_p_0_2.m and primitive_p_0_2.m (available for p <= 7).", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"vMatrix", "[", 
   RowBox[{"n_Integer", "?", "Positive"}], "]"}], ":=", 
  RowBox[{"Outer", "[", 
   RowBox[{"Power", ",", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Subscript", "[", 
       RowBox[{"\[Lambda]", ",", "i"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", 
        RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", 
      RowBox[{"n", "-", "1"}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]s", "[", "n_", "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    SubscriptBox["\[Lambda]", "i"], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Z", "[", 
    RowBox[{"d_", ",", "k_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"Gamma", "[", 
     RowBox[{"k", "*", "d"}], "]"}], 
    RowBox[{"Product", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Gamma", "[", 
        RowBox[{"d", "+", "1", "-", "j"}], "]"}], "*", 
       RowBox[{"Gamma", "[", 
        RowBox[{"k", "-", "j"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "0", ",", 
        RowBox[{"d", "-", "1"}]}], "}"}]}], "]"}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rule", "[", "d_", "]"}], ":=", 
   RowBox[{
    SubscriptBox["\[Lambda]", 
     RowBox[{"d", "-", "1"}]], "->", 
    RowBox[{"1", "-", 
     RowBox[{"Total", "@", 
      RowBox[{"\[Lambda]s", "[", 
       RowBox[{"d", "-", "1"}], "]"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"d_", ",", "k_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Product", "[", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["\[Lambda]", "i"], 
        RowBox[{"k", "-", "d"}]], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", 
         RowBox[{"d", "-", "1"}]}], "}"}]}], "]"}], 
     SuperscriptBox[
      RowBox[{"Det", "[", 
       RowBox[{"vMatrix", "[", "d", "]"}], "]"}], "2"]}], "/.", 
    RowBox[{"rule", "[", "d", "]"}]}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.8522620338928633`*^9, 3.852262038234366*^9}, 
   3.852262223442627*^9, {3.852262270589039*^9, 3.852262294161346*^9}, {
