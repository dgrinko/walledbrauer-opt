Notebook[{

Cell[CellGroupData[{
Cell["Deciding the principal eigenvalue", "Title",ExpressionUUID->"a18b81f9-1d70-4b96-ae09-5bfbb756d98d"],

Cell["Application 1 | Qubit states and multiple copies", "Subtitle",ExpressionUUID->"3876cf06-da11-4a90-a05c-34ea46c13829"],

Cell["\<\
Reproduces Sect. 7.1, Example 7.1, equations (152)-(153), and Figures 4 and \
5. The task is to decide whether the largest eigenvalue exceeds the threshold \
c, using n identical copies. The code uses p for the copy count n.\
\>", "Text",ExpressionUUID->"138c35ad-accd-4440-8dd6-0c6dc2989b11"],

Cell["\<\
Evaluate from the top in Mathematica. The default calculation uses d = 2, k = \
2 and n = 1,...,8. This notebook uses its own symbol context. The precomputed \
Sage traces are included below; the final consistency check also reads the \
repository's idempotents directory.\
\>", "Text",ExpressionUUID->"ea8ecd0b-8a70-46c8-95cf-7a7e4a824a47"],

Cell[CellGroupData[{

Cell["Parameters", "Section",ExpressionUUID->"a7939b3e-0a0e-400c-ac87-f1b59ac7702c"],

Cell["\<\
d is fixed to 2 because pData contains qubit traces. k is the \
induced-ensemble parameter (an integer at least 2); k = 2 gives the figure in \
the paper. pMax can be any integer from 1 to 8. The threshold remains \
symbolic on 1/2 < c < 1. Reevaluate the notebook after changing parameters.\
\>", "Text",ExpressionUUID->"477c771e-2c3b-496d-9c8d-c6001ab7e836"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"d", "=", "2"}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"k", "=", "2"}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"pMax", "=", "8"}], ";"}], "\[IndentingNewLine]"}], "Input",
 CellTags->
  "app1-parameters",ExpressionUUID->"e19efb61-6e3a-4351-b245-a5edbd2d5f8f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Eigenvalue density", "Section",ExpressionUUID->"a648bb61-02db-45be-8ad9-6e01e90ac76e"],

Cell["\<\
Z normalizes the induced eigenvalue density. The rule eliminates the last \
eigenvalue using the unit-trace condition; f contains the squared Vandermonde \
factor.\
\>", "Text",ExpressionUUID->"b944cde9-d6b6-44a1-88c4-11492a9aa5db"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"vMatrix", "[",
   RowBox[{"n_Integer", "?", "Positive"}], "]"}], ":=",
  RowBox[{"Outer", "[",
   RowBox[{"Power", ",",
    RowBox[{"Table", "[",
     RowBox[{
      RowBox[{"Subscript", "[",
       RowBox[{"\[Lambda]", ",", "i"}], "]"}], ",",
      RowBox[{"{",
       RowBox[{"i", ",", "0", ",",
        RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",",
    RowBox[{"Range", "[",
     RowBox[{"0", ",",
      RowBox[{"n", "-", "1"}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"\[Lambda]s", "[", "n_", "]"}], ":=",
  RowBox[{"Table", "[",
   RowBox[{
    SubscriptBox["\[Lambda]", "i"], ",",
    RowBox[{"{",
     RowBox[{"i", ",", "0", ",",
      RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{
   RowBox[{"Z", "[",
    RowBox[{"d_", ",", "k_"}], "]"}], ":=",
   FractionBox[
    RowBox[{"Gamma", "[",
     RowBox[{"k", "*", "d"}], "]"}],
    RowBox[{"Product", "[",
     RowBox[{
      RowBox[{
       RowBox[{"Gamma", "[",
        RowBox[{"d", "+", "1", "-", "j"}], "]"}], "*",
       RowBox[{"Gamma", "[",
        RowBox[{"k", "-", "j"}], "]"}]}], ",",
      RowBox[{"{",
       RowBox[{"j", ",", "0", ",",
        RowBox[{"d", "-", "1"}]}], "}"}]}], "]"}]]}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{
   RowBox[{"rule", "[", "d_", "]"}], ":=",
   RowBox[{
    SubscriptBox["\[Lambda]",
     RowBox[{"d", "-", "1"}]], "->",
    RowBox[{"1", "-",
     RowBox[{"Total", "@",
      RowBox[{"\[Lambda]s", "[",
       RowBox[{"d", "-", "1"}], "]"}]}]}]}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{
   RowBox[{"f", "[",
    RowBox[{"d_", ",", "k_"}], "]"}], ":=",
   RowBox[{
    RowBox[{
     RowBox[{"Product", "[",
      RowBox[{
       SuperscriptBox[
        SubscriptBox["\[Lambda]", "i"],
        RowBox[{"k", "-", "d"}]], ",",
       RowBox[{"{",
        RowBox[{"i", ",", "0", ",",
         RowBox[{"d", "-", "1"}]}], "}"}]}], "]"}],
     SuperscriptBox[
      RowBox[{"Det", "[",
       RowBox[{"vMatrix", "[", "d", "]"}], "]"}], "2"]}], "/.",
    RowBox[{"rule", "[", "d", "]"}]}]}], ";"}]}], "Input",
 CellTags->
  "app1-density",ExpressionUUID->"47b9d0eb-91a8-4d74-a45f-0fe91fbc67e1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Precomputed traces", "Section",ExpressionUUID->"d91bce99-2db9-457c-b4cf-af6a2c224ea3"],

Cell["\<\
pData stores the original Sage polynomials for n = 1,...,8. The coefficients \
c_i describe a decision operator and are constrained to [0,1]. They are \
distinct from the threshold c. The TeXForm parser converts the Sage \
subscripts into Mathematica subscripts.\
\>", "Text",ExpressionUUID->"74f8d443-f56a-4099-84cb-392d11465324"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*",
   RowBox[{"Alternative", " ", "computation", " ", "of", " ", "the", " ",
    RowBox[{"trace", ":", " ",
     RowBox[{
     "precomputed", " ", "in", " ", "Sage", " ", "and", " ", "imported", " ",
      "into", " ", "pData", " ", "variable"}]}]}], "*)"}],
  "\[IndentingNewLine]",
  RowBox[{
   RowBox[{
    RowBox[{"pData", "=",
     RowBox[{"{",
      RowBox[{"\"\<c_0*l_0+c_0*l_1\>\"", ",",
       "\[IndentingNewLine]", \
"\"\<c_0*l_0^2+c_0*l_0*l_1+c_1*l_0*l_1+c_0*l_1^2\>\"", ",",
       "\[IndentingNewLine]", "\"\<c_0*l_0^3 + c_0*l_0^2*l_1 + \
2*c_1*l_0^2*l_1 + c_0*l_0*l_1^2 + 2*c_1*l_0*l_1^2 + c_0*l_1^3\>\"", ",",
       "\[IndentingNewLine]", \
"\"\<c_0*l_0^4+c_0*l_0^3*l_1+3*c_1*l_0^3*l_1+c_0*l_0^2*l_1^2+3*c_1*l_0^2*l_1^\
2+2*c_2*l_0^2*l_1^2+c_0*l_0*l_1^3+3*c_1*l_0*l_1^3+c_0*l_1^4\>\"",
       ",", "\"\<c_0*l_0^5 + c_0*l_0^4*l_1 + 4*c_1*l_0^4*l_1 + \
c_0*l_0^3*l_1^2 + 4*c_1*l_0^3*l_1^2 + 5*c_2*l_0^3*l_1^2 + c_0*l_0^2*l_1^3 + \
4*c_1*l_0^2*l_1^3 + 5*c_2*l_0^2*l_1^3 + c_0*l_0*l_1^4 + 4*c_1*l_0*l_1^4 + \
c_0*l_1^5\>\"",
       ",", "\"\<c_0*l_0^6 + c_0*l_0^5*l_1 + 5*c_1*l_0^5*l_1 + \
c_0*l_0^4*l_1^2 + 5*c_1*l_0^4*l_1^2 + 9*c_2*l_0^4*l_1^2 + c_0*l_0^3*l_1^3 + \
5*c_1*l_0^3*l_1^3 + 9*c_2*l_0^3*l_1^3 + 5*c_3*l_0^3*l_1^3 + c_0*l_0^2*l_1^4 + \
5*c_1*l_0^2*l_1^4 + 9*c_2*l_0^2*l_1^4 + c_0*l_0*l_1^5 + 5*c_1*l_0*l_1^5 + \
c_0*l_1^6\>\"", ",",
       "\[IndentingNewLine]", \
"\"\<c_0*l_0^7+c_0*l_0^6*l_1+6*c_1*l_0^6*l_1+c_0*l_0^5*l_1^2+6*c_1*l_0^5*l_1^\
2+14*c_2*l_0^5*l_1^2+c_0*l_0^4*l_1^3+6*c_1*l_0^4*l_1^3+14*c_2*l_0^4*l_1^3+14*\
c_3*l_0^4*l_1^3+c_0*l_0^3*l_1^4+6*c_1*l_0^3*l_1^4+14*c_2*l_0^3*l_1^4+14*c_3*l_\
0^3*l_1^4+c_0*l_0^2*l_1^5+6*c_1*l_0^2*l_1^5+14*c_2*l_0^2*l_1^5+c_0*l_0*l_1^6+\
6*c_1*l_0*l_1^6+c_0*l_1^7\>\"", ",",
       "\[IndentingNewLine]", "\"\<c_0*l_0^8 + c_0*l_0^7*l_1 + \
7*c_1*l_0^7*l_1 + c_0*l_0^6*l_1^2 + 7*c_1*l_0^6*l_1^2 + 20*c_2*l_0^6*l_1^2 + \
c_0*l_0^5*l_1^3 + 7*c_1*l_0^5*l_1^3 + 20*c_2*l_0^5*l_1^3 + 28*c_3*l_0^5*l_1^3 \
+ c_0*l_0^4*l_1^4 + 7*c_1*l_0^4*l_1^4 + 20*c_2*l_0^4*l_1^4 + \
28*c_3*l_0^4*l_1^4 + 14*c_4*l_0^4*l_1^4 + c_0*l_0^3*l_1^5 + 7*c_1*l_0^3*l_1^5 \
+ 20*c_2*l_0^3*l_1^5 + 28*c_3*l_0^3*l_1^5 + c_0*l_0^2*l_1^6 + \
7*c_1*l_0^2*l_1^6 + 20*c_2*l_0^2*l_1^6 + c_0*l_0*l_1^7 + 7*c_1*l_0*l_1^7 + \
c_0*l_1^8\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]",
   RowBox[{
    RowBox[{"optVars", "[", "p_", "]"}], ":=",
    RowBox[{"DeleteCases", "[",
     RowBox[{
      RowBox[{"Variables", "[",
       RowBox[{"ToExpression", "[",
        RowBox[{
         RowBox[{"pData", "[",
          RowBox[{"[", "p", "]"}], "]"}], ",", "TeXForm"}], "]"}], "]"}], ",",
      SubscriptBox["l", "_"]}], "]"}]}], "\[IndentingNewLine]",
   RowBox[{
    RowBox[{"conds", "=",
     RowBox[{"Table", "[",
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(",
          RowBox[{"0", "<=", "#", "<=", "1"}], ")"}], "&"}], "/@",
        RowBox[{"optVars", "[", "p", "]"}]}], ",",
       RowBox[{"{",
        RowBox[{"p", ",", "1", ",", "8"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
   RowBox[{
    RowBox[{
     RowBox[{"trace", "[",
      RowBox[{"p_", ",", "d_"}], "]"}], ":=",
     RowBox[{
      RowBox[{"ToExpression", "[",
       RowBox[{
        RowBox[{"pData", "[",
         RowBox[{"[", "p", "]"}], "]"}], ",", "TeXForm"}], "]"}], "//.",
      RowBox[{"{",
       RowBox[{
        RowBox[{"l", "->", "\[Lambda]"}], ",",
        RowBox[{"rule", "[", "d", "]"}]}], "}"}]}]}], ";"}]}]}]], "Input",
 CellTags->
  "app1-trace-data",ExpressionUUID->"bbb899b0-debc-46dc-ba38-d344a0a53297"],

Cell["\<\
For example, the four-copy trace before eliminating the second eigenvalue is:\
\
\>", "Text",ExpressionUUID->"7050abfd-4987-4319-b6f0-2756ecd18ef9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ToExpression", "[",
    RowBox[{
     RowBox[{"pData", "[",
      RowBox[{"[", "4", "]"}], "]"}], ",", "TeXForm"}], "]"}], "/.",
   RowBox[{"l", "->", "\[Lambda]"}]}], " ", "//", "Simplify"}]], "Input",
 CellTags->
  "app1-trace-example",ExpressionUUID->"886ea8c8-945a-494b-9a22-e83e0ee034f0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Success probability and optimization", "Section",ExpressionUUID->"925fc631-7096-4437-93c7-fea96394c308"],

Cell["\<\
term0 is the prior probability that the largest eigenvalue exceeds c. term1 \
and term2 give the contributions of the decision operator below and above the \
threshold. Maximize solves for the coefficients c_i at each symbolic \
threshold.\
\>", "Text",ExpressionUUID->"92045f8d-74c3-4c3c-b58a-caf401fb9001"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"term0", "[",
   RowBox[{"d_", ",", "k_"}], "]"}], ":=",
  RowBox[{
   RowBox[{"Z", "[",
    RowBox[{"d", ",", "k"}], "]"}], "*",
   RowBox[{"Integrate", "[",
    RowBox[{
     RowBox[{
      RowBox[{"Boole", "[",
       RowBox[{
        RowBox[{"Max", "[",
         RowBox[{
          RowBox[{"\[Lambda]s", "[", "d", "]"}], "/.",
          RowBox[{"rule", "[", "d", "]"}]}], "]"}], ">=", "c"}], "]"}], "*",
      RowBox[{"f", "[",
       RowBox[{"d", ",", "k"}], "]"}]}], ",",
     RowBox[{
      RowBox[{"\[Lambda]s", "[",
       RowBox[{"d", "-", "1"}], "]"}], "\[Element]",
      RowBox[{"Simplex", "[",
       RowBox[{"d", "-", "1"}], "]"}]}], ",",
     RowBox[{"Assumptions", "\[Rule]",
      RowBox[{"{",
       RowBox[{
        RowBox[{"k", "\[Element]",
         TemplateBox[{},
          "PositiveIntegers"]}], ",",
        RowBox[{
         RowBox[{"1", "/", "d"}], "<", "c", "<", "1"}]}], "}"}]}]}],
    "]"}]}]}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"term1", "[",
   RowBox[{"p_", ",", "d_", ",", "k_"}], "]"}], ":=",
  RowBox[{
   RowBox[{"Z", "[",
    RowBox[{"d", ",", "k"}], "]"}], "*",
   RowBox[{"Integrate", "[",
    RowBox[{
     RowBox[{
      RowBox[{"trace", "[",
       RowBox[{"p", ",", "d"}], "]"}], "*",
      RowBox[{"Boole", "[",
       RowBox[{
        RowBox[{"Max", "[",
         RowBox[{
          RowBox[{"\[Lambda]s", "[", "d", "]"}], "/.",
          RowBox[{"rule", "[", "d", "]"}]}], "]"}], "<=", "c"}], "]"}], "*",
      RowBox[{"f", "[",
       RowBox[{"d", ",", "k"}], "]"}]}], ",",
     RowBox[{
      RowBox[{"\[Lambda]s", "[",
       RowBox[{"d", "-", "1"}], "]"}], "\[Element]",
      RowBox[{"Simplex", "[",
       RowBox[{"d", "-", "1"}], "]"}]}], ",",
     RowBox[{"Assumptions", "\[Rule]",
      RowBox[{"{",
       RowBox[{
        RowBox[{"k", "\[Element]",
         TemplateBox[{},
          "PositiveIntegers"]}], ",",
        RowBox[{
         RowBox[{"1", "/", "d"}], "<", "c", "<", "1"}]}], "}"}]}]}],
    "]"}]}]}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"term2", "[",
   RowBox[{"p_", ",", "d_", ",", "k_"}], "]"}], ":=",
  RowBox[{
   RowBox[{"Z", "[",
    RowBox[{"d", ",", "k"}], "]"}], "*",
   RowBox[{"Integrate", "[",
    RowBox[{
     RowBox[{
      RowBox[{"trace", "[",
       RowBox[{"p", ",", "d"}], "]"}], "*",
      RowBox[{"Boole", "[",
       RowBox[{
        RowBox[{"Max", "[",
         RowBox[{
          RowBox[{"\[Lambda]s", "[", "d", "]"}], "/.",
          RowBox[{"rule", "[", "d", "]"}]}], "]"}], ">=", "c"}], "]"}], "*",
      RowBox[{"f", "[",
       RowBox[{"d", ",", "k"}], "]"}]}], ",",
     RowBox[{
      RowBox[{"\[Lambda]s", "[",
       RowBox[{"d", "-", "1"}], "]"}], "\[Element]",
      RowBox[{"Simplex", "[",
       RowBox[{"d", "-", "1"}], "]"}]}], ",",
     RowBox[{"Assumptions", "\[Rule]",
      RowBox[{"{",
       RowBox[{
        RowBox[{"k", "\[Element]",
         TemplateBox[{},
          "PositiveIntegers"]}], ",",
        RowBox[{
         RowBox[{"1", "/", "d"}], "<", "c", "<", "1"}]}], "}"}]}]}],
    "]"}]}]}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"prob", "[",
   RowBox[{"p_", ",", "d_", ",", "k_"}], "]"}], ":=",
  RowBox[{
   RowBox[{"term0", "[",
    RowBox[{"d", ",", "k"}], "]"}], "+",
   RowBox[{"term1", "[",
    RowBox[{"p", ",", "d", ",", "k"}], "]"}], "-",
   RowBox[{"term2", "[",
    RowBox[{"p", ",", "d", ",", "k"}], "]"}]}]}]}], "Input",
 CellTags->
  "app1-probability",ExpressionUUID->"6219d3fc-9cc7-4d88-9a6f-f609175b0d6b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"If", "[",
   RowBox[{
    RowBox[{"!",
     RowBox[{"TrueQ", "[",
      RowBox[{
       RowBox[{"d", "\[Equal]", "2"}], "&&",
       RowBox[{"IntegerQ", "[", "k", "]"}], "&&",
       RowBox[{"k", "\[GreaterEqual]", "2"}], "&&",
       RowBox[{"IntegerQ", "[", "pMax", "]"}], "&&",
       RowBox[{"1", "\[LessEqual]", "pMax", "\[LessEqual]",
        RowBox[{"Length", "[", "pData", "]"}]}]}], "]"}]}], ",",
    RowBox[{
     RowBox[{
     "Print", "[", "\"\<Use d = 2, integer k >= 2, and integer pMax between 1 \
and 8.\>\"", "]"}], ";",
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"probs", "=",
   RowBox[{"Table", "[",
    RowBox[{
     RowBox[{"prob", "[",
      RowBox[{"p", ",", "d", ",", "k"}], "]"}], ",",
     RowBox[{"{",
      RowBox[{"p", ",", "1", ",", "pMax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"maxprobs", "=",
   RowBox[{"Table", "[",
    RowBox[{
     RowBox[{"Maximize", "[",
      RowBox[{
       RowBox[{"{",
        RowBox[{
         RowBox[{
         "probs", "\[LeftDoubleBracket]", "p", "\[RightDoubleBracket]"}], ",",
         RowBox[{
         "conds", "\[LeftDoubleBracket]", "p", "\[RightDoubleBracket]"}], ",",
         RowBox[{
          FractionBox["1", "d"], "<", "c", "<", "1"}]}], "}"}], ",",
       RowBox[{"optVars", "[", "p", "]"}]}], "]"}], ",",
     RowBox[{"{",
      RowBox[{"p", ",", "1", ",", "pMax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"successProbabilities", "=",
   RowBox[{"maxprobs", "\[LeftDoubleBracket]",
    RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}]}],
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellTags->
  "app1-optimize",ExpressionUUID->"fc14b0c3-6282-486b-9bb1-eec39ad0619b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Optimal probability curves", "Section",ExpressionUUID->"e0249cd5-2a33-4391-af6d-fd3c466d04f2"],

Cell["\<\
The curves correspond to n = 1,...,pMax. The symbolic optimization uses the \
open threshold interval; the endpoint probabilities are understood as limits.\
\
\>", "Text",ExpressionUUID->"5b22a000-c2bf-424c-a99d-8e75fc13bf09"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"probabilityPlot", "=",
  RowBox[{"Plot", "[",
   RowBox[{
    RowBox[{"Evaluate", "[", "successProbabilities", "]"}], ",",
    RowBox[{"{",
     RowBox[{"c", ",",
      FractionBox["1", "d"], ",", "1"}], "}"}], ",",
    RowBox[{"PlotRange", "\[Rule]",
     RowBox[{"{",
      RowBox[{"0.45`", ",", "1.01`"}], "}"}]}], ",",
    RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",",
    RowBox[{"PlotStyle", "\[Rule]",
     RowBox[{"Table", "[",
      RowBox[{
       RowBox[{"Darker", "[",
        RowBox[{"Green", ",",
         FractionBox["p",
          RowBox[{"2", " ", "pMax"}]]}], "]"}], ",",
       RowBox[{"{",
        RowBox[{"p", ",", "1", ",", "pMax"}], "}"}]}], "]"}]}], ",",
    RowBox[{"Frame", "\[Rule]", "True"}], ",",
    RowBox[{"FrameLabel", "\[Rule]",
     RowBox[{"{",
      RowBox[{"\"\<Threshold c\>\"",
       ",", "\"\<Optimal success probability\>\""}], "}"}]}], ",",
    RowBox[{"PlotLegends", "\[Rule]",
     RowBox[{"Placed", "[",
      RowBox[{
       RowBox[{"Table", "[",
        RowBox[{
         TemplateBox[{"\"n = \"", "p"},
          "RowDefault"], ",",
         RowBox[{"{",
          RowBox[{"p", ",", "1", ",", "pMax"}], "}"}]}], "]"}], ",",
       "Right"}], "]"}]}], ",",
    RowBox[{"ImageSize", "\[Rule]", "400"}]}], "]"}]}]], "Input",
 CellTags->"app1-plot",ExpressionUUID->"e7a6bc5d-c34e-45da-96af-5a32b5901b55"],

Cell[BoxData[
 TemplateBox[{
   GraphicsBox[{
     InterpretationBox[{
       TagBox[{{{{}, {},
           TagBox[{
             Directive[
              Opacity[1.],
              AbsoluteThickness[2],
              RGBColor[0,
               NCache[15/16, 0.9375], 0]],
             LineBox[CompressedData["
