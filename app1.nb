Cell[CellGroupData[{

Cell["Exact expressions", "Section",ExpressionUUID->"5ebc5443-c137-438b-a068-dec2461d2a51"],

Cell["\<\
The full exact piecewise formulas remain available in successProbabilities; \
maxprobs also contains the maximizing decision coefficients. The first three \
formulas are displayed separately when available.\
\>", "Text",ExpressionUUID->"1cfb4469-c1e0-483e-94a7-7f71ccd85996"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"exactSuccessProbabilities", "=",
   RowBox[{"Simplify", "[", "successProbabilities", "]"}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{"Column", "[",
  RowBox[{"Take", "[",
   RowBox[{"exactSuccessProbabilities", ",",
    RowBox[{"UpTo", "[", "3", "]"}]}], "]"}], "]"}]}], "Input",
 CellTags->
  "app1-exact",ExpressionUUID->"e0086797-97ee-44b8-9e6c-caf7cf839e6c"]
}, Closed]],

Cell[CellGroupData[{

Cell["Additional ensemble examples: k = 3", "Section",ExpressionUUID->"358c56ac-8afe-4ad0-984f-78985b63c33b"],

Cell["\<\
These are the original unoptimized probability expressions for n = 2, 3 and 4 \
at d = 2, k = 3. They retain the decision coefficients c_i and do not change \
the main parameters.\
\>", "Text",ExpressionUUID->"985ca55d-ce88-416b-af60-2793ba0f63de"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"additionalProbabilities", "=",
   RowBox[{"Table", "[",
    RowBox[{
     RowBox[{"prob", "[",
      RowBox[{"p", ",", "2", ",", "3"}], "]"}], ",",
     RowBox[{"{",
      RowBox[{"p", ",", "2", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{"Column", "[", "additionalProbabilities", "]"}]}], "Input",
 CellTags->
  "app1-additional",ExpressionUUID->"f432aa79-fb56-48d2-b160-f82f59b77d70"]
}, Closed]],

Cell[CellGroupData[{

Cell["Consistency check from primitive idempotents", "Section",ExpressionUUID->"ea9b21a2-6de7-429b-951a-21e8616ad065"],

Cell["\<\
This independent reconstruction uses idempotents/metadata_p_0_2.m and \
idempotents/primitive_p_0_2.m. The repository provides these files for p = \
1,...,7. This check may take longer than the preceding calculation; every \
difference must be exactly zero.\
\>", "Text",ExpressionUUID->"9fbedae7-e923-4b9e-8f5e-88e4bf56ccaa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*",
   RowBox[{
   "Compute", " ", "the", " ", "trace", " ", "inside", " ", "this", " ",
    "notebook"}], "*)"}], "\[IndentingNewLine]",
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"FName", "[",
      RowBox[{"name_", ",", "p_", ",", "q_", ",", "d_"}], "]"}], ":=",
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], "<>", "name", "<>", "\"\<_\>\"",
       "<>",
      RowBox[{"ToString", "[", "p", "]"}], "<>", "\"\<_\>\"", "<>",
      RowBox[{"ToString", "[", "q", "]"}], "<>", "\"\<_\>\"", "<>",
      RowBox[{"ToString", "[", "d", "]"}]}]}], ";"}], "\[IndentingNewLine]",
   RowBox[{
    RowBox[{
     RowBox[{"irrepDims", "[",
      RowBox[{"p_", ",", "q_", ",", "d_"}], "]"}], ":=",
     RowBox[{
      RowBox[{"irrepDims", "[",
       RowBox[{"p", ",", "q", ",", "d"}], "]"}], "=", " ",
      RowBox[{
       RowBox[{"Import", "[",
        RowBox[{
         RowBox[{"FName", "[",

          RowBox[{"\"\<idempotents/metadata\>\"", ",", "p", ",", "q", ",",
           "d"}], "]"}], "<>", "\"\<.m\>\""}], "]"}], "[",
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]",
   RowBox[{
    RowBox[{
     RowBox[{"basis", "[",
      RowBox[{"p_", ",", "q_", ",", "d_"}], "]"}], ":=",
     RowBox[{
      RowBox[{"basis", "[",
       RowBox[{"p", ",", "q", ",", "d"}], "]"}], "=",
      RowBox[{
       RowBox[{"Import", "[",
        RowBox[{
         RowBox[{"FName", "[",

          RowBox[{"\"\<idempotents/metadata\>\"", ",", "p", ",", "q", ",",
           "d"}], "]"}], "<>", "\"\<.m\>\""}], "]"}], "[",
       RowBox[{"[", "3", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]",
   RowBox[{
    RowBox[{
     RowBox[{"\[CurlyEpsilon]", "[",
      RowBox[{"p_", ",", "q_", ",", "d_"}], "]"}], ":=",
     RowBox[{"Import", "[",
      RowBox[{
       RowBox[{"FName", "[",
        RowBox[{"\"\<idempotents/primitive\>\"", ",", "p", ",", "q", ",",
         "d"}], "]"}], "<>", "\"\<.m\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]",
   RowBox[{
    RowBox[{
     RowBox[{"\[CurlyEpsilon]Central", "[",
      RowBox[{"p_", ",", "q_", ",", "d_"}], "]"}], ":=",
     RowBox[{"Total", "/@",
      RowBox[{"Table", "[",
       RowBox[{
        RowBox[{
         RowBox[{"\[CurlyEpsilon]", "[",
          RowBox[{"p", ",", "q", ",", "d"}], "]"}], "[",
         RowBox[{"[",
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[",
             RowBox[{
              RowBox[{"irrepDims", "[",
               RowBox[{"p", ",", "q", ",", "d"}], "]"}], "[",
              RowBox[{"[",
               RowBox[{"1", ";;",
                RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "]"}], "+", "1"}], ";;",
           RowBox[{"Total", "[",
            RowBox[{
             RowBox[{"irrepDims", "[",
              RowBox[{"p", ",", "q", ",", "d"}], "]"}], "[",
             RowBox[{"[",
              RowBox[{"1", ";;", "i"}], "]"}], "]"}], "]"}]}], "]"}], "]"}], ",",
        RowBox[{"{",
         RowBox[{"i", ",", "1", ",",
          RowBox[{"Length", "@",
           RowBox[{"irrepDims", "[",
            RowBox[{"p", ",", "q", ",", "d"}], "]"}]}]}], "}"}]}], "]"}]}]}],
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]",
   RowBox[{
    RowBox[{"traceNew", "[",
     RowBox[{"p_", ",", "d_"}], "]"}], ":=",
    RowBox[{
     RowBox[{"traceNew", "[",
      RowBox[{"p", ",", "d"}], "]"}], "=",
     RowBox[{
      RowBox[{
       RowBox[{"Sum", "[",
        RowBox[{
         RowBox[{
          SubscriptBox["c",
           RowBox[{"i", "-", "1"}]],
          RowBox[{"(",
           RowBox[{
            RowBox[{
             RowBox[{"\[CurlyEpsilon]Central", "[",
              RowBox[{"p", ",", "0", ",", "d"}], "]"}], "[",
             RowBox[{"[", "i", "]"}], "]"}], ".",
            RowBox[{"Table", "[",
             RowBox[{
              RowBox[{"Sum", "[",
               RowBox[{
                RowBox[{
                 RowBox[{"Product", "[",
                  RowBox[{
                   SubscriptBox["\[Lambda]", "i"], ",",
                   RowBox[{"{",
                    RowBox[{"i", ",",
                    RowBox[{"IntegerDigits", "[",
                    RowBox[{
                    RowBox[{"x", "-", "1"}], ",", "d", ",", "p"}], "]"}]}],
                    "}"}]}], "]"}],
                 RowBox[{"Times", "[",
                  RowBox[{"Sequence", "@@",
                   RowBox[{"(",
                    RowBox[{
                    RowBox[{
                    RowBox[{"KroneckerDelta", "[",
                    RowBox[{
                    RowBox[{
                    RowBox[{"IntegerDigits", "[",
                    RowBox[{
                    RowBox[{"x", "-", "1"}], ",", "d", ",", "p"}], "]"}], "[",
                    RowBox[{"[",
                    RowBox[{"Abs", "[",
                    RowBox[{"#", "[",
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], ",",

                    RowBox[{
                    RowBox[{"IntegerDigits", "[",
                    RowBox[{
                    RowBox[{"x", "-", "1"}], ",", "d", ",", "p"}], "]"}], "[",
                    RowBox[{"[",
                    RowBox[{"Abs", "[",
                    RowBox[{"#", "[",
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "]"}]}],
                    "]"}], "&"}], "/@",
                    RowBox[{"(",
                    RowBox[{"List", "@@",
                    RowBox[{
                    RowBox[{"basis", "[",
                    RowBox[{"p", ",", "0", ",", "d"}], "]"}], "[",
                    RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], ")"}]}],
                  "]"}]}], ",",
                RowBox[{"{",
                 RowBox[{"x", ",", "1", ",",
                  SuperscriptBox["d", "p"]}], "}"}]}], "]"}], ",",
              RowBox[{"{",
               RowBox[{"j", ",", "1", ",",
                RowBox[{"p", "!"}]}], "}"}]}], "]"}]}], ")"}]}], ",",
         RowBox[{"{",
          RowBox[{"i", ",",
           RowBox[{"Length", "@",
            RowBox[{"irrepDims", "[",
             RowBox[{"p", ",", "0", ",", "d"}], "]"}]}]}], "}"}]}], "]"}], "/.",
       RowBox[{"rule", "[", "d", "]"}]}], "//", "Expand"}]}]}]}]}]], "Input",
 CellTags->
  "app1-trace-reconstruction",ExpressionUUID->"d107259c-ce89-4e23-b3be-\
6fa0a924b7f1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"traceDifferences", "=",
   RowBox[{"Table", "[",
    RowBox[{
     RowBox[{"Expand", "[",
      RowBox[{
       RowBox[{"traceNew", "[",
        RowBox[{"p", ",", "2"}], "]"}], "-",
       RowBox[{"trace", "[",
        RowBox[{"p", ",", "2"}], "]"}]}], "]"}], ",",
     RowBox[{"{",
      RowBox[{"p", ",", "1", ",", "7"}], "}"}]}], "]"}]}],
  ";"}], "\[IndentingNewLine]", "traceDifferences"}], "Input",
 CellTags->
  "app1-trace-check",ExpressionUUID->"3bf331c1-c9f7-4649-9279-008e593634f0"],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
  "}"}]], "Output",ExpressionUUID->"100b4464-3df7-418c-808c-f3b45e18c19b"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Run summary", "Section",ExpressionUUID->"27cc0e72-3950-4c1f-8fab-9a2dbe4df4c2"],

Cell["\<\
A successful default run has eight optimum curves and seven exact zero trace \
differences. The summary is computed from this evaluation.\
\>", "Text",ExpressionUUID->"7eaf7922-412a-40b4-8b25-02aa174cdb70"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"runSummary", "=",
  RowBox[{"Association", "[",
   RowBox[{
    RowBox[{"\"\<Parameters {d, k, pMax}\>\"", "\[Rule]",
     RowBox[{"{",
      RowBox[{"d", ",", "k", ",", "pMax"}], "}"}]}], ",",
    RowBox[{"\"\<Optimum curves\>\"", "\[Rule]",
     RowBox[{"Length", "[", "successProbabilities", "]"}]}], ",",
    RowBox[{"\"\<All seven trace differences are zero\>\"", "\[Rule]",
     RowBox[{"traceDifferences", "===",
      RowBox[{"ConstantArray", "[",
       RowBox[{"0", ",", "7"}], "]"}]}]}], ",",
    RowBox[{"\"\<n = 3 reference probability\>\"", "\[Rule]",
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{"pMax", "\[GreaterEqual]", "3"}], ",",
       RowBox[{"N", "[",
        RowBox[{
         RowBox[{
          RowBox[{
          "successProbabilities", "\[LeftDoubleBracket]", "3",
           "\[RightDoubleBracket]"}], "/.", "\[VeryThinSpace]",
          RowBox[{"c", "\[Rule]", "referenceThreshold"}]}], ",", "16"}],
        "]"}], ",",
       RowBox[{"Missing", "[", "\"\<NotComputed\>\"", "]"}]}], "]"}]}]}],
   "]"}]}]], "Input",
 CellTags->
  "app1-summary",ExpressionUUID->"0269ef32-d66e-4492-a53d-943bc327fd50"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]",
  RowBox[{
   RowBox[{"\<\"Parameters {d, k, pMax}\"\>", "\[Rule]",
    RowBox[{"{",
     RowBox[{"2", ",", "2", ",", "8"}], "}"}]}], ",",
   RowBox[{"\<\"Optimum curves\"\>", "\[Rule]", "8"}], ",",
   RowBox[{"\<\"All seven trace differences are zero\"\>", "\[Rule]",
    "True"}], ",",
   RowBox[{"\<\"n = 3 reference probability\"\>", "\[Rule]",
    "0.56696802123665724182823445823324900195`16."}]}],
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"540dc3cc-f997-4155-8a3a-\
a30051f7aa6b"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
