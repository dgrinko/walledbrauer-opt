       RowBox[{"[", "3", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CurlyEpsilon]", "[", 
      RowBox[{"p_", ",", "q_", ",", "d_"}], "]"}], ":=", 
     RowBox[{"Import", "[", 
      RowBox[{
       RowBox[{"FName", "[", 
        RowBox[{
        "\"\<idempotents/primitive\>\"", ",", "p", ",", "q", ",", "d"}], 
        "]"}], "<>", "\"\<.m\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CurlyEpsilon]Central", "[", 
