     RowBox[{"Total", "/@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CurlyEpsilon]", "[", 
          RowBox[{"p", ",", "q", ",", "d"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{"irrepDims", "[", 
               RowBox[{"p", ",", "q", ",", "d"}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"1", ";;", 
                RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "]"}], "+", "1"}], ";;", 
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"irrepDims", "[", 
              RowBox[{"p", ",", "q", ",", "d"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ";;", "i"}], "]"}], "]"}], "]"}]}], "]"}], "]"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "@", 
           RowBox[{"irrepDims", "[", 
            RowBox[{"p", ",", "q", ",", "d"}], "]"}]}]}], "}"}]}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"traceNew", "[", 
     RowBox[{"p_", ",", "d_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"traceNew", "[", 
      RowBox[{"p", ",", "d"}], "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          SubscriptBox["c", 
           RowBox[{"i", "-", "1"}]], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"\[CurlyEpsilon]Central", "[", 
              RowBox[{"p", ",", "0", ",", "d"}], "]"}], "[", 
             RowBox[{"[", "i", "]"}], "]"}], ".", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Product", "[", 
                  RowBox[{
                   SubscriptBox["\[Lambda]", "i"], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", 
                    RowBox[{"IntegerDigits", "[", 
                    RowBox[{
                    RowBox[{"x", "-", "1"}], ",", "d", ",", "p"}], "]"}]}], 
                    "}"}]}], "]"}], 
                 RowBox[{"Times", "[", 
                  RowBox[{"Sequence", "@@", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"KroneckerDelta", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"IntegerDigits", "[", 
                    RowBox[{
                    RowBox[{"x", "-", "1"}], ",", "d", ",", "p"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], ",", 
                    
                    RowBox[{
                    RowBox[{"IntegerDigits", "[", 
                    RowBox[{
                    RowBox[{"x", "-", "1"}], ",", "d", ",", "p"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "]"}]}], 
                    "]"}], "&"}], "/@", 
                    RowBox[{"(", 
                    RowBox[{"List", "@@", 
                    RowBox[{
                    RowBox[{"basis", "[", 
                    RowBox[{"p", ",", "0", ",", "d"}], "]"}], "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], ")"}]}], 
                  "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"x", ",", "1", ",", 
                  SuperscriptBox["d", "p"]}], "}"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", 
                RowBox[{"p", "!"}]}], "}"}]}], "]"}]}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "@", 
            RowBox[{"irrepDims", "[", 
