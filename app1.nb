Cell[CellGroupData[{

Cell["Numerical reference point", "Subsection",ExpressionUUID->"41d02fdc-4657-4868-bf30-bec2a089837e"],

Cell["\<\
At the default parameters, n = 3 and c = 0.913830846 give approximately \
0.5669680212366558. The table evaluates the computed optimum for every \
available copy count.\
\>", "Text",ExpressionUUID->"59bc8d6e-2ed7-4755-92a8-0a0cf9f26f18"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"referenceThreshold", "=",
   FractionBox["913830846",
    SuperscriptBox["10", "9"]]}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"referenceProbabilities", "=",
   RowBox[{"Table", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"p", ",",
       RowBox[{"N", "[",
        RowBox[{
         RowBox[{
          RowBox[{
          "successProbabilities", "\[LeftDoubleBracket]", "p",
           "\[RightDoubleBracket]"}], "/.", "\[VeryThinSpace]",
          RowBox[{"c", "\[Rule]", "referenceThreshold"}]}], ",", "16"}],
        "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"p", ",", "1", ",", "pMax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{"Grid", "[",
  RowBox[{
   RowBox[{"Prepend", "[",
    RowBox[{"referenceProbabilities", ",",
     RowBox[{"{",
      RowBox[{"\"\<Copies n\>\"", ",", "\"\<Success probability\>\""}],
      "}"}]}], "]"}], ",",
   RowBox[{"Frame", "\[Rule]", "All"}], ",",
   RowBox[{"Alignment", "\[Rule]", "Left"}]}], "]"}]}], "Input",
 CellTags->
  "app1-reference",ExpressionUUID->"0c9887d4-7530-47dc-abec-f9aa4efbd6b9"],

