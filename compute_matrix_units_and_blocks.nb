        RowBox[{"contractTensor", "[",
         RowBox[{"p", ",", "q", ",", "d"}], "]"}]}], ",",
       RowBox[{"{",
        RowBox[{
         RowBox[{
          RowBox[{"(",
           RowBox[{"p", "+", "q"}], ")"}], "!"}], ",",
         RowBox[{
          RowBox[{"(",
           RowBox[{"p", "+", "q"}], ")"}], "!"}]}], "}"}]}],
      "]"}]}]}]}]}]], "Input",
