Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ",
   RowBox[{"Diagram", " ", "multiplication", " ", "tensor"}], " ", "*)"}],
  "\[IndentingNewLine]",
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"prodRule", "[",
      RowBox[{"p_", ",", "q_", ",", "d_", ",", "i_", ",", "j_"}], "]"}], ":=",
     RowBox[{"Module", "[",
      RowBox[{
       RowBox[{"{",
        RowBox[{
         RowBox[{"basis", "=",
          RowBox[{"WalledBrauerBasis", "[",
           RowBox[{"p", ",", "q"}], "]"}]}], ",", "prod"}], "}"}], ",",
       RowBox[{
        RowBox[{"prod", "=",
         RowBox[{"MultiplyPair2", "[",
          RowBox[{
           RowBox[{"basis", "[",
            RowBox[{"[", "i", "]"}], "]"}], ",",
           RowBox[{"basis", "[",
            RowBox[{"[", "j", "]"}], "]"}], ",", "d"}], "]"}]}], ";",
        RowBox[{
         RowBox[{"{",
          RowBox[{"i", ",", "j", ",",
           RowBox[{
            RowBox[{"Position", "[",
             RowBox[{"basis", ",",
              RowBox[{"prod", "[",
               RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "[",
            RowBox[{"[",
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "}"}], "->",
         RowBox[{"prod", "[",
          RowBox[{"[", "2", "]"}], "]"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
   RowBox[{
    RowBox[{
     RowBox[{"mulTensor", "[",
      RowBox[{"p_", ",", "q_", ",", "d_"}], "]"}], ":=",
     RowBox[{
      RowBox[{"mulTensor", "[",
       RowBox[{"p", ",", "q", ",", "d"}], "]"}], "=",
      RowBox[{"SparseArray", "[",
       RowBox[{
        RowBox[{"Flatten", "@",
         RowBox[{"Table", "[",
          RowBox[{
           RowBox[{"prodRule", "[",
            RowBox[{"p", ",", "q", ",", "d", ",", "i", ",", "j"}], "]"}], ",",
           RowBox[{"{",
            RowBox[{"i", ",", "1", ",",
             RowBox[{
              RowBox[{"(",
               RowBox[{"p", "+", "q"}], ")"}], "!"}]}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"j", ",", "1", ",",
             RowBox[{
              RowBox[{"(",
               RowBox[{"p", "+", "q"}], ")"}], "!"}]}], "}"}]}], "]"}]}], ",",
        RowBox[{"{",
         RowBox[{
          RowBox[{
           RowBox[{"(",
            RowBox[{"p", "+", "q"}], ")"}], "!"}], ",",
          RowBox[{
           RowBox[{"(",
