Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Sort", " ", "the", " ", "diagram", " ", "description", " ", "to", " ", 
    "make", " ", "it", " ", "canonical"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"SortB", "[", "\[Sigma]_", "]"}], ":=", 
     RowBox[{"Sort", "@", 
      RowBox[{"Map", "[", 
       RowBox[{"Sort", ",", "\[Sigma]", ",", "1"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Given", " ", "the", " ", "line", " ", "defined", " ", "by", " ", "a", 
      " ", "pair", " ", "of", " ", "vertices"}], ",", " ", 
     RowBox[{
     "flip", " ", "the", " ", "vertices", " ", "which", " ", "are", " ", 
      "located", " ", "after", " ", "the", " ", "wall", " ", "at", " ", 
      "level", " ", "p"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FlipPair", "[", 
     RowBox[{"pair_", ",", "p_"}], "]"}], ":=", 
    RowBox[{"Sort", "@", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "#", "]"}], ">", "p"}], ",", 
          RowBox[{"-", "#"}], ",", "#"}], "]"}], "&"}], "/@", "pair"}], 
      ")"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Transpose", " ", "a", " ", "Brauer", " ", "diagram"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"BT", "[", "\[Sigma]_", "]"}], ":=", 
     RowBox[{"SortB", "[", 
      RowBox[{"B", "[", 
       RowBox[{"Sequence", "@@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"FlipPair", "[", 
            RowBox[{"#", ",", "0"}], "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{"\[Sigma]", "/.", 
            RowBox[{"B", "->", "List"}]}], ")"}]}], ")"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "Walled", " ", "Brauer", " ", "Algebra", " ", 
     "generators"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"WalledBrauerGenerators", "[", 
      RowBox[{"p_", ",", "q_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"WalledBrauerGenerators", "[", 
       RowBox[{"p", ",", "q"}], "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"B", "[", 
         RowBox[{"Sequence", "@@", "#"}], "]"}], "&"}], "/@", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"FlipPair", "[", 
           RowBox[{"#", ",", "p"}], "]"}], "&"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"FoldList", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ReplacePart", "[", 
                RowBox[{"#1", ",", 
                 RowBox[{"#2", "->", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "#2"}], ",", 
                    RowBox[{"#1", "[", 
                    RowBox[{"[", "#2", "]"}], "]"}]}], "}"}]}]}], "]"}], 
               "&"}], ",", "#", ",", 
              RowBox[{"Range", "[", 
               RowBox[{"p", "+", "q"}], "]"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "&"}], "/@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"i", "-", "1"}], "]"}], "~", "Join", "~", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i", "+", "1"}], ",", "i"}], "}"}], "~", "Join", "~", 
             RowBox[{"Range", "[", 
              RowBox[{
               RowBox[{"i", "+", "2"}], ",", 
               RowBox[{"p", "+", "q"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"p", "+", "q", "-", "1"}]}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "Walled", " ", "Brauer", " ", "Algebra", " ", "basis"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"WalledBrauerBasis", "[", 
      RowBox[{"p_", ",", "q_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"WalledBrauerBasis", "[", 
       RowBox[{"p", ",", "q"}], "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"SortB", "[", 
          RowBox[{"B", "[", 
           RowBox[{"Sequence", "@@", "#"}], "]"}], "]"}], ")"}], "&"}], "/@", 
       
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"FlipPair", "[", 
           RowBox[{"#", ",", "p"}], "]"}], "&"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"FoldList", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ReplacePart", "[", 
                RowBox[{"#1", ",", 
                 RowBox[{"#2", "->", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "#2"}], ",", 
                    RowBox[{"#1", "[", 
                    RowBox[{"[", "#2", "]"}], "]"}]}], "}"}]}]}], "]"}], 
               "&"}], ",", "#", ",", 
              RowBox[{"Range", "[", 
               RowBox[{"p", "+", "q"}], "]"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "&"}], "/@", 
          RowBox[{"Permutations", "[", 
           RowBox[{"Range", "[", 
            RowBox[{"p", "+", "q"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}]}]}], ";"}]}]}]], "Input",
