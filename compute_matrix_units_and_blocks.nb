Cell[CellGroupData[{

Cell["6. Generate and compare", "Section",
 PageBreakAbove->True,ExpressionUUID->"1ba4ce24-ce7c-4c4e-b816-d8382a6508bd"],

Cell["\<\
Each case writes primitive, metadata, elementary, and blocks files into \
outputRoot and verifies every export by re-importing it. MatchesShippedFiles \
independently compares those files on disk with the shipped references using \
exact SameQ, in that order; four True values mean exact agreement with the \
repository data. A missing reference is reported explicitly. Generation can \
take several minutes for the default pair.\
\>", "Text",ExpressionUUID->"d73151d7-00ba-4628-a2cf-bb95f45d7357"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ExportChecked", "[",
    RowBox[{"path_", ",", "data_"}], "]"}], ":=",
   RowBox[{"Module", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"written", ",", "reloaded"}], "}"}], ",",
     RowBox[{
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{"!",
         RowBox[{"FreeQ", "[",
          RowBox[{"data", ",",
           RowBox[{"$Failed", "|", "$Aborted"}]}], "]"}]}], ",",
        RowBox[{
         RowBox[{"Print", "[",

          RowBox[{"\"\<Refusing to export a failed calculation: \>\"", ",",
           "path"}], "]"}], ";",
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";",
      RowBox[{"written", "=",
       RowBox[{"Export", "[",
        RowBox[{"path", ",", "data"}], "]"}]}], ";",
      RowBox[{"reloaded", "=",
       RowBox[{"If", "[",
        RowBox[{
         RowBox[{"FileExistsQ", "[", "path", "]"}], ",",
         RowBox[{"Import", "[", "path", "]"}], ",", "$Failed"}], "]"}]}], ";",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"!",
          RowBox[{"FreeQ", "[",
           RowBox[{"reloaded", ",",
            RowBox[{"$Failed", "|", "$Aborted"}]}], "]"}]}], "||",
         RowBox[{"written", "===", "$Failed"}], "||",
         RowBox[{"!",
          RowBox[{"FileExistsQ", "[", "path", "]"}]}], "||",
         RowBox[{"!",
          RowBox[{"reloaded", "===", "data"}]}]}], ",",
        RowBox[{
         RowBox[{"Print", "[",

          RowBox[{"\"\<Export or exact round-trip verification failed: \>\"",
           ",", "path"}], "]"}], ";",
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "path"}]}], "]"}]}],
  ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"generationResults", "=",
   RowBox[{"Table", "[",
    RowBox[{
     RowBox[{"Module", "[",
      RowBox[{
       RowBox[{"{",
        RowBox[{
         RowBox[{"p", "=",
          RowBox[{
          "case", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",",
         RowBox[{"q", "=",
          RowBox[{
          "case", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ",",
         RowBox[{"d", "=",
          RowBox[{
          "case", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], ",",
         RowBox[{"start", "=",
          RowBox[{"AbsoluteTime", "[", "]"}]}], ",", "primitive", ",",
         "metadata", ",", "elementary", ",", "diagramBlocks", ",", "paths", ",",
          "comparisons", ",", "generatedData", ",", "referenceData"}], "}"}],
       ",",
       RowBox[{
        RowBox[{"If", "[",
         RowBox[{
          RowBox[{"!",
           RowBox[{"FileExistsQ", "[",
            RowBox[{
             RowBox[{"FNameD", "[",

              RowBox[{"\"\<wba_idempotents_db/primitive\>\"", ",", "p", ",",
               "q", ",", "d"}], "]"}], "<>", "\"\<.txt\>\""}], "]"}]}], ",",
          RowBox[{
           RowBox[{"Print", "[",
            RowBox[{"\"\<Missing Sage source for \>\"", ",", "case"}], "]"}],
           ";",
           RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";",
        RowBox[{"Print", "[",
         RowBox[{"\"\<Generating \>\"", ",", "case", ",", "\"\< ...\>\""}],
         "]"}], ";",
        RowBox[{
        "Print", "[", "\"\<  primitive idempotents and metadata\>\"", "]"}], ";",
        RowBox[{"primitive", "=",
         RowBox[{"IdempotentMatrix", "[",
          RowBox[{"p", ",", "q", ",", "d"}], "]"}]}], ";",
        RowBox[{"metadata", "=",
         RowBox[{"MetaData", "[",
          RowBox[{"p", ",", "q", ",", "d"}], "]"}]}], ";",
        RowBox[{"ExportChecked", "[",
         RowBox[{
          RowBox[{
           RowBox[{"FName", "[",

            RowBox[{"\"\<idempotents/primitive\>\"", ",", "p", ",", "q", ",",
             "d"}], "]"}], "<>", "\"\<.m\>\""}], ",", "primitive"}], "]"}], ";",
        RowBox[{"ExportChecked", "[",
         RowBox[{
          RowBox[{
           RowBox[{"FName", "[",

            RowBox[{"\"\<idempotents/metadata\>\"", ",", "p", ",", "q", ",",
             "d"}], "]"}], "<>", "\"\<.m\>\""}], ",", "metadata"}], "]"}], ";",
        RowBox[{"Print", "[",
         RowBox[{"\"\<  matrix units; elapsed \>\"", ",",
          RowBox[{"Round", "[",
           RowBox[{
            RowBox[{
             RowBox[{"AbsoluteTime", "[", "]"}], "-", "start"}], ",",
            "0.01`"}], "]"}], ",", "\"\< s\>\""}], "]"}], ";",
        RowBox[{"elementary", "=",
         RowBox[{"Elementary", "[",
          RowBox[{"p", ",", "q", ",", "d"}], "]"}]}], ";",
        RowBox[{"ExportChecked", "[",
         RowBox[{
          RowBox[{
           RowBox[{"FName", "[",

            RowBox[{"\"\<idempotents/elementary\>\"", ",", "p", ",", "q", ",",
              "d"}], "]"}], "<>", "\"\<.m\>\""}], ",", "elementary"}], "]"}],
        ";",
        RowBox[{"Print", "[",
         RowBox[{"\"\<  diagram blocks; elapsed \>\"", ",",
          RowBox[{"Round", "[",
           RowBox[{
            RowBox[{
             RowBox[{"AbsoluteTime", "[", "]"}], "-", "start"}], ",",
            "0.01`"}], "]"}], ",", "\"\< s\>\""}], "]"}], ";",
        RowBox[{"diagramBlocks", "=",
         RowBox[{"Blocks", "[",
          RowBox[{"p", ",", "q", ",", "d"}], "]"}]}], ";",
        RowBox[{"ExportChecked", "[",
         RowBox[{
          RowBox[{
           RowBox[{"FName", "[",
            RowBox[{"\"\<blocks/blocks\>\"", ",", "p", ",", "q", ",", "d"}],
            "]"}], "<>", "\"\<.m\>\""}], ",", "diagramBlocks"}], "]"}], ";",
        RowBox[{"Print", "[",
         RowBox[{"\"\<  exports verified; elapsed \>\"", ",",
          RowBox[{"Round", "[",
           RowBox[{
            RowBox[{
             RowBox[{"AbsoluteTime", "[", "]"}], "-", "start"}], ",",
            "0.01`"}], "]"}], ",", "\"\< s\>\""}], "]"}], ";",
        RowBox[{"paths", "=",
         RowBox[{
          RowBox[{"(",
           RowBox[{
            RowBox[{"#1", "<>", "\"\<_\>\"", "<>",
             RowBox[{"StringRiffle", "[",
              RowBox[{
               RowBox[{"ToString", "/@", "case"}], ",", "\"\<_\>\""}], "]"}],
             "<>", "\"\<.m\>\""}], "&"}], ")"}], "/@",
          RowBox[{"{",

           RowBox[{"\"\<idempotents/primitive\>\"",
            ",", "\"\<idempotents/metadata\>\"",
            ",", "\"\<idempotents/elementary\>\"",
            ",", "\"\<blocks/blocks\>\""}], "}"}]}]}], ";",
        RowBox[{"comparisons", "=",
         RowBox[{
          RowBox[{"(",
           RowBox[{
            RowBox[{"If", "[",
             RowBox[{
              RowBox[{"!",
               RowBox[{"FileExistsQ", "[",
                RowBox[{"FileNameJoin", "[",
                 RowBox[{"{",
                  RowBox[{"outputRoot", ",", "#1"}], "}"}], "]"}], "]"}]}], ",",
               "False", ",",
              RowBox[{"If", "[",
               RowBox[{
                RowBox[{"FileExistsQ", "[",
                 RowBox[{"FileNameJoin", "[",
                  RowBox[{"{",
                   RowBox[{"sourceRoot", ",", "#1"}], "}"}], "]"}], "]"}], ",",
                RowBox[{
                 RowBox[{"generatedData", "=",
                  RowBox[{"Import", "[",
                   RowBox[{"FileNameJoin", "[",
                    RowBox[{"{",
                    RowBox[{"outputRoot", ",", "#1"}], "}"}], "]"}], "]"}]}],
                 ";",
                 RowBox[{"referenceData", "=",
                  RowBox[{"Import", "[",
                   RowBox[{"FileNameJoin", "[",
                    RowBox[{"{",
                    RowBox[{"sourceRoot", ",", "#1"}], "}"}], "]"}], "]"}]}],
                 ";",
                 RowBox[{
                  RowBox[{"FreeQ", "[",
                   RowBox[{
                    RowBox[{"{",
                    RowBox[{"generatedData", ",", "referenceData"}], "}"}], ",",
                    RowBox[{"$Failed", "|", "$Aborted"}]}], "]"}], "&&",
                  RowBox[{"generatedData", "===", "referenceData"}]}]}], ",",

                RowBox[{"Missing", "[", "\"\<NoShippedReference\>\"", "]"}]}],
                "]"}]}], "]"}], "&"}], ")"}], "/@", "paths"}]}], ";",
        RowBox[{"Association", "[",
         RowBox[{
          RowBox[{"\"\<Case\>\"", "\[Rule]", "case"}], ",",
          RowBox[{"\"\<OutputRoot\>\"", "\[Rule]", "outputRoot"}], ",",
          RowBox[{"\"\<ModuleDimensions\>\"", "\[Rule]",
           RowBox[{"First", "[", "metadata", "]"}]}], ",",
          RowBox[{"\"\<DiagramCount\>\"", "\[Rule]",
           RowBox[{"Length", "[", "diagramBlocks", "]"}]}], ",",
          RowBox[{"\"\<MatchesShippedFiles\>\"", "\[Rule]", "comparisons"}], ",",
          RowBox[{"\"\<Seconds\>\"", "\[Rule]",
           RowBox[{"Round", "[",
            RowBox[{
             RowBox[{
              RowBox[{"AbsoluteTime", "[", "]"}], "-", "start"}], ",",
             "0.01`"}], "]"}]}]}], "]"}]}]}], "]"}], ",",
     RowBox[{"{",
      RowBox[{"case", ",", "cases"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{"Dataset", "[", "generationResults", "]"}]}], "Input",ExpressionUUID->\
"8fddc848-6bee-44af-af85-08e52398f485"]
}, Open  ]]
}, Open  ]]
},
