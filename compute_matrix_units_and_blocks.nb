Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Contract", " ", "a", " ", "Brauer", " ", "diagram", " ", "at", " ", "one",
     " ", "fixed", " ", "position", " ", "l"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ContractDiag", "[", 
      RowBox[{"diag__", ",", 
       RowBox[{"{", 
        RowBox[{"l_", ",", "d_"}], "}"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"new", ",", "data"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"data", "=", 
         RowBox[{"diag", "/.", 
          RowBox[{"B", "->", "List"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"new", "=", 
         RowBox[{"Sort", "@", 
          RowBox[{"Flatten", "@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"data", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "\[Intersection]", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "!=", 
                RowBox[{"{", "}"}]}], ",", 
               RowBox[{"Complement", "[", 
                RowBox[{
                 RowBox[{"data", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}], ",", 
               RowBox[{"{", "}"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "@", "data"}]}], "}"}]}], "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"new", "==", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"d", " ", 
           RowBox[{"SortB", "[", 
            RowBox[{"B", "[", 
             RowBox[{"Sequence", "@@", 
              RowBox[{"Sort", "@", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"data", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "\[Intersection]", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "!=", 
                    RowBox[{"{", "}"}]}], ",", "Nothing", ",", 
                   RowBox[{"data", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "1", ",", 
                   RowBox[{"Length", "@", "data"}]}], "}"}]}], "]"}]}]}], 
             "]"}], "]"}]}], ",", " ", 
          RowBox[{"SortB", "[", 
           RowBox[{"B", "[", 
            RowBox[{"Sequence", "@@", 
             RowBox[{"Sort", "@", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"data", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "\[Intersection]", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "!=", 
                    RowBox[{"{", "}"}]}], ",", "Nothing", ",", 
                    RowBox[{"data", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "1", ",", 
                    RowBox[{"Length", "@", "data"}]}], "}"}]}], "]"}], "~", 
                "Join", "~", 
                RowBox[{"{", "new", "}"}]}], ")"}]}]}], "]"}], "]"}]}], 
         "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Contract", " ", "a", " ", 
     RowBox[{"lin", ".", " ", "comb", ".", " ", "of"}], " ", "Brauer", " ", 
     "diagrams", " ", "x", " ", "at", " ", "one", " ", "fixed", " ", 
     "position", " ", "l"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ContractOne", "[", 
      RowBox[{"x_", ",", 
       RowBox[{"{", 
        RowBox[{"l_", ",", "d_"}], "}"}]}], "]"}], ":=", 
     RowBox[{"x", "/.", 
      RowBox[{
       RowBox[{"B", "[", "lst__", "]"}], ":>", 
       RowBox[{"ContractDiag", "[", 
        RowBox[{
         RowBox[{"{", "lst", "}"}], ",", 
