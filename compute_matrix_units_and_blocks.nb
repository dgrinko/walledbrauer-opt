    "\[CurlyEpsilon]", ",", "\[CurlyEpsilon]pm", ",", "blocks", ",",
    "ansatzNumeric", ",", "\[CurlyEpsilon]db"}], "]"}], ";"}], "\[IndentingNewLine]",
 RowBox[{
