Notebook[{

Cell[CellGroupData[{
Cell["Matrix units and irreducible blocks", "Title",ExpressionUUID->"b4aff29a-75ae-4e38-9660-df4d1447529f"],

Cell["Reproducible conversion of Sage idempotents to Wolfram data", "Subtitle",ExpressionUUID->"77e89d85-e536-4d43-87dc-4d084d36772b"],

Cell["\<\
This notebook constructs primitive idempotents, metadata, normalized matrix \
units, and irreducible blocks from wba_idempotents_db. These are the exact \
algebra data used by the optimization notebooks. Evaluate from the top; every \
run clears its algebra caches and recomputes the selected cases.\
\>", "Text",ExpressionUUID->"576f2638-3242-41c6-8e97-3966a8762c5c"],

Cell[CellGroupData[{

Cell["1. Cases and output directory", "Section",ExpressionUUID->"f9fb8c97-4c11-4cce-b383-858e1e88cb0b"],

Cell["\<\
The default cases are {p, q, d} = {4, 1, 2} and {4, 1, 3}. Their \
simple-module dimensions are {1, 4, 5} and {1, 3, 2, 4, 8, 3}; each has \
(p+q)! = 120 diagrams. The output directory is a fresh temporary folder \
printed below. Inspect its four files per case before copying them into the \
repository. Change cases to generate other available Sage data.\
\>", "Text",ExpressionUUID->"1803969f-74ca-400b-aa3d-785ccc237dbd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[",
   RowBox[{
   "s", ",", "Parse", ",", "SortB", ",", "FlipPair", ",", "BT", ",",
    "WalledBrauerGenerators", ",", "WalledBrauerBasis", ",", "ContractDiag", ",",
     "ContractOne", ",", "Contract", ",", "FullContract", ",", "ContractOne2",
     ",", "Contract2", ",", "FullContract2", ",", "MultiplyPair2", ",",
    "MultiplyPair", ",", "Ts", ",", "\[CurlyEpsilon]Ts", ",", "dB", ",",
    "distinct", ",", "\[Lambda]s", ",", "irreps", ",", "FNameD", ",", "FName",
     ",", "MetaData", ",", "IdempotentMatrix", ",", "irrepDims", ",",
    "\[CurlyEpsilon]Load", ",", "prodRule", ",", "mulTensor", ",",
    "contractTensor", ",", "mulTensorMatrix", ",", "MulContractTensor", ",",
    "FullContractVec", ",", "Multiply", ",", "block", ",", "dim\[Lambda]U", ",",
     "factorN", ",", "\[Epsilon]", ",", "\[CurlyEpsilon]", ",",
    "\[CurlyEpsilon]pm", ",", "blocks", ",", "ansatzNumeric", ",",
    "\[CurlyEpsilon]db", ",", "Elementary", ",", "Blocks", ",",
    "ExportChecked"}], "]"}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"sourceRoot", "=",
   RowBox[{"NotebookDirectory", "[", "]"}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"cases", "=",
   RowBox[{"{",
    RowBox[{
     RowBox[{"{",
      RowBox[{"4", ",", "1", ",", "2"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"4", ",", "1", ",", "3"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"outputRoot", "=",
   RowBox[{"CreateDirectory", "[", "]"}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"CreateDirectory", "[",
   RowBox[{"FileNameJoin", "[",
    RowBox[{"{",
     RowBox[{"outputRoot", ",", "\"\<idempotents\>\""}], "}"}], "]"}], "]"}],
  ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"CreateDirectory", "[",
   RowBox[{"FileNameJoin", "[",
    RowBox[{"{",
     RowBox[{"outputRoot", ",", "\"\<blocks\>\""}], "}"}], "]"}], "]"}],
  ";"}], "\[IndentingNewLine]", "outputRoot"}], "Input",ExpressionUUID->\
"6819f469-72f2-4b76-8e10-c096a9bd83bf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Read and parse Sage data", "Section",ExpressionUUID->"6c8f122a-4f4b-4555-ae08-28f024cb64dc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"s", "[",
     RowBox[{"p_", ",", "q_", ",", "d_"}], "]"}], ":=",
    RowBox[{
     RowBox[{"s", "[",
      RowBox[{"p", ",", "q", ",", "d"}], "]"}], "=",
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{"d", "\[GreaterEqual]",
        RowBox[{"p", "+", "q"}]}], ",",
       RowBox[{"Import", "[",
        RowBox[{
         RowBox[{"(",
          RowBox[{"sourceRoot", "<>", "$PathnameSeparator"}], ")"}],
         "<>", "\"\<wba_idempotents_db/primitive_\>\"", "<>",
         RowBox[{"ToString", "[", "p", "]"}], "<>", "\"\<_\>\"", "<>",
         RowBox[{"ToString", "[", "q", "]"}], "<>", "\"\<.txt\>\""}], "]"}], ",",
       RowBox[{"Import", "[",
        RowBox[{
         RowBox[{"(",
          RowBox[{"sourceRoot", "<>", "$PathnameSeparator"}], ")"}],
         "<>", "\"\<wba_idempotents_db/primitive_\>\"", "<>",
         RowBox[{"ToString", "[", "p", "]"}], "<>", "\"\<_\>\"", "<>",
         RowBox[{"ToString", "[", "q", "]"}], "<>", "\"\<_\>\"", "<>",
         RowBox[{"ToString", "[", "d", "]"}], "<>", "\"\<.txt\>\""}], "]"}]}],
       "]"}]}]}], ";"}], "\[IndentingNewLine]"}]], "Input",ExpressionUUID->\
"0fd8ef6d-c7f2-4944-a123-5d354842a189"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ",
   RowBox[{
   "Parse", " ", "Sage", " ", "output", " ", "into", " ", "Mathematica"}],
   " ", "*)"}], "\[IndentingNewLine]",
  RowBox[{
   RowBox[{
    RowBox[{"Parse", "[", "s_", "]"}], ":=",
    RowBox[{"Module", "[",
     RowBox[{
      RowBox[{"{",
       RowBox[{"t", ",", "Ts", ",", "\[CurlyEpsilon]s"}], "}"}], ",",
      "\[IndentingNewLine]",
      RowBox[{"(*", " ",
       RowBox[{
       "Remove", " ", "the", " ", "first", " ", "and", " ", "last", " ",
        "curly", " ", "brace"}], " ", "*)"}], "\[IndentingNewLine]",
      RowBox[{
       RowBox[{"t", "=",
        RowBox[{"StringTake", "[",
         RowBox[{"s", ",",
          RowBox[{"{",
           RowBox[{"2", ",",
            RowBox[{"-", "2"}]}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]",
       RowBox[{"(*", " ",
        RowBox[{"Fix", " ", "the", " ", "brackets", " ", "of", " ", "B"}],
        " ", "*)"}], "\[IndentingNewLine]",
       RowBox[{"t", "=",
        RowBox[{"StringReplace", "[",
         RowBox[{"t", ",",
          RowBox[{"{",
           RowBox[{
            RowBox[{"\"\<{{\>\"", "->", "\"\<[{\>\""}], ",",
            RowBox[{"\"\<}}\>\"", "->", "\"\<}]\>\""}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]",
       RowBox[{"(*", " ",
        RowBox[{
        "Add", " ", "extra", " ", "colons", " ", "before", " ", "path", " ",
         "labels", " ", "and", " ", "convert", " ", "all", " ", "braces", " ",
          "to", " ", "curly"}], " ", "*)"}], "\[IndentingNewLine]",
       RowBox[{"t", "=",
        RowBox[{"StringReplace", "[",
         RowBox[{"t", ",",
          RowBox[{"{",
           RowBox[{
            RowBox[{"\"\<(([\>\"", "->", "\"\<:{{[\>\""}], ",",
            RowBox[{"\"\<([\>\"", "->", "\"\<{[\>\""}], ",",
            RowBox[{"\"\<]))\>\"", "->", "\"\<]}}\>\""}], ",",
            RowBox[{"\"\<])\>\"", "->", "\"\<]}\>\""}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]",
       RowBox[{"(*", " ",
        RowBox[{
         RowBox[{"Replace", " ", "[", "]"}], "->",
         RowBox[{
          RowBox[{
           RowBox[{"{", "}"}], " ",
           RowBox[{"and", " ", "[",
            RowBox[{"1", ",", "2"}], "]"}]}], "->",
          RowBox[{"{",
           RowBox[{"1", ",", "2"}], "}"}]}]}], " ", "*)"}],
       "\[IndentingNewLine]",
       RowBox[{"t", "=",
        RowBox[{"StringReplace", "[",
         RowBox[{"t", ",",
          RowBox[{"{",
           RowBox[{"\"\<[]\>\"", "->", "\"\<{}\>\""}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]",
       RowBox[{"t", "=",
        RowBox[{"StringReplace", "[",
         RowBox[{"t", ",",
          RowBox[{"{",
           RowBox[{
            RowBox[{"StringExpression", "[",
             RowBox[{"\"\<[\>\"", ",",
              RowBox[{"i", ":", "NumberString"}]}], "]"}], ":>",
            RowBox[{"\"\<{\>\"", "~~", "i"}]}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]",
       RowBox[{"t", "=",
        RowBox[{"StringReplace", "[",
         RowBox[{"t", ",",
          RowBox[{"{",
           RowBox[{
            RowBox[{"StringExpression", "[",
             RowBox[{
              RowBox[{"i", ":", "NumberString"}], ",", "\"\<]\>\""}], "]"}], ":>",
            RowBox[{"i", "~~", "\"\<}\>\""}]}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]",
       RowBox[{"(*", " ",
        RowBox[{"Remove", " ", "commas", " ", "after", " ", "idempotents"}],
        " ", "*)"}], "\[IndentingNewLine]",
       RowBox[{"t", "=",
        RowBox[{"StringReplace", "[",
         RowBox[{"t", ",",
          RowBox[{"\"\<, :\>\"", "->", "\"\< : \>\""}]}], "]"}]}], ";",
       "\[IndentingNewLine]",
       RowBox[{"(*", " ",
        RowBox[{
        "Split", " ", "the", " ", "string", " ", "at", " ", "colons"}], " ",
        "*)"}], "\[IndentingNewLine]",
       RowBox[{"t", "=",
        RowBox[{"StringSplit", "[",
         RowBox[{"t", ",", "\"\<:\>\""}], "]"}]}], ";", "\[IndentingNewLine]",
       RowBox[{"(*", " ",
        RowBox[{"Mathematica", " ", "expression"}], " ", "*)"}],
       "\[IndentingNewLine]",
       RowBox[{"t", "=",
        RowBox[{"ToExpression", "[", "t", "]"}]}], ";", "\[IndentingNewLine]",
       RowBox[{"(*", " ",
        RowBox[{
        "Final", " ", "vertex", " ", "on", " ", "a", " ", "path", " ", "and",
         " ", "its", " ", "idempotent"}], " ", "*)"}], "\[IndentingNewLine]",

       RowBox[{
        RowBox[{"{",
         RowBox[{"Ts", ",", "\[CurlyEpsilon]s"}], "}"}], "=",
        RowBox[{
         RowBox[{"Partition", "[",
          RowBox[{"t", ",", "2"}], "]"}], "\[Transpose]"}]}], ";",
       "\[IndentingNewLine]",
       RowBox[{"{",
        RowBox[{"Ts", ",", "\[CurlyEpsilon]s"}], "}"}]}]}],
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 InitializationCell->
  True,ExpressionUUID->"c73e2dfd-b5a4-4c3c-8454-bac313d01eca"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Diagram operations", "Section",ExpressionUUID->"75cd0a4a-98e4-4bd4-9291-108381f72467"],

Cell["\<\
Diagrams use signed vertex pairs. Contractions preserve the remaining labels; \
a site in the second register has local index l-p-q. Explicit p and q \
arguments make two-register traces independent of any notebook parameter \
assignments.\
\>", "Text",ExpressionUUID->"21c14e61-90ca-4828-b5bc-ab85ae42ad02"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ",
   RowBox[{
   "Sort", " ", "the", " ", "diagram", " ", "description", " ", "to", " ",
    "make", " ", "it", " ", "canonical"}], " ", "*)"}], "\[IndentingNewLine]",
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"SortB", "[", "\[Sigma]_", "]"}], ":=",
     RowBox[{"Sort", "@",
      RowBox[{"Map", "[",
       RowBox[{"Sort", ",", "\[Sigma]", ",", "1"}], "]"}]}]}], ";"}],
   "\[IndentingNewLine]", "\[IndentingNewLine]",
   RowBox[{"(*",
    RowBox[{
     RowBox[{
     "Given", " ", "the", " ", "line", " ", "defined", " ", "by", " ", "a", " ",
       "pair", " ", "of", " ", "vertices"}], ",", " ",
     RowBox[{
     "flip", " ", "the", " ", "vertices", " ", "which", " ", "are", " ",
      "located", " ", "after", " ", "the", " ", "wall", " ", "at", " ",
      "level", " ", "p"}]}], "*)"}], "\[IndentingNewLine]",
   RowBox[{
    RowBox[{"FlipPair", "[",
     RowBox[{"pair_", ",", "p_"}], "]"}], ":=",
    RowBox[{"Sort", "@",
     RowBox[{"(",
      RowBox[{
       RowBox[{
        RowBox[{"If", "[",
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "#", "]"}], ">", "p"}], ",",
          RowBox[{"-", "#"}], ",", "#"}], "]"}], "&"}], "/@", "pair"}],
      ")"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]",
   RowBox[{"(*", " ",
    RowBox[{"Transpose", " ", "a", " ", "Brauer", " ", "diagram"}], " ",
    "*)"}], "\[IndentingNewLine]",
   RowBox[{
    RowBox[{
     RowBox[{"BT", "[", "\[Sigma]_", "]"}], ":=",
     RowBox[{"SortB", "[",
      RowBox[{"B", "[",
       RowBox[{"Sequence", "@@",
        RowBox[{"(",
         RowBox[{
          RowBox[{
           RowBox[{"FlipPair", "[",
            RowBox[{"#", ",", "0"}], "]"}], "&"}], "/@",
          RowBox[{"(",
           RowBox[{"\[Sigma]", "/.",
            RowBox[{"B", "->", "List"}]}], ")"}]}], ")"}]}], "]"}], "]"}]}],
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]",
   RowBox[{"(*",
    RowBox[{
    "Generate", " ", "Walled", " ", "Brauer", " ", "Algebra", " ",
     "generators"}], "*)"}], "\[IndentingNewLine]",
   RowBox[{
    RowBox[{
     RowBox[{"WalledBrauerGenerators", "[",
      RowBox[{"p_", ",", "q_"}], "]"}], ":=",
     RowBox[{
      RowBox[{"WalledBrauerGenerators", "[",
       RowBox[{"p", ",", "q"}], "]"}], "=",
      RowBox[{
       RowBox[{
        RowBox[{"B", "[",
         RowBox[{"Sequence", "@@", "#"}], "]"}], "&"}], "/@",
       RowBox[{"Map", "[",
        RowBox[{
         RowBox[{
          RowBox[{"FlipPair", "[",
           RowBox[{"#", ",", "p"}], "]"}], "&"}], ",",
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"FoldList", "[",
             RowBox[{
              RowBox[{
               RowBox[{"ReplacePart", "[",
                RowBox[{"#1", ",",
                 RowBox[{"#2", "->",
                  RowBox[{"{",
                   RowBox[{
                    RowBox[{"-", "#2"}], ",",
                    RowBox[{"#1", "[",
                    RowBox[{"[", "#2", "]"}], "]"}]}], "}"}]}]}], "]"}],
               "&"}], ",", "#", ",",
              RowBox[{"Range", "[",
               RowBox[{"p", "+", "q"}], "]"}]}], "]"}], "[",
            RowBox[{"[",
             RowBox[{"-", "1"}], "]"}], "]"}], "&"}], "/@",
          RowBox[{"Table", "[",
           RowBox[{
            RowBox[{
             RowBox[{"Range", "[",
              RowBox[{"i", "-", "1"}], "]"}], "~", "Join", "~",
             RowBox[{"{",
              RowBox[{
               RowBox[{"i", "+", "1"}], ",", "i"}], "}"}], "~", "Join", "~",
             RowBox[{"Range", "[",
              RowBox[{
               RowBox[{"i", "+", "2"}], ",",
               RowBox[{"p", "+", "q"}]}], "]"}]}], ",",
            RowBox[{"{",
             RowBox[{"i", ",", "1", ",",
              RowBox[{"p", "+", "q", "-", "1"}]}], "}"}]}], "]"}]}], ",",
         RowBox[{"{", "2", "}"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]",
   RowBox[{"(*",
    RowBox[{
    "Generate", " ", "Walled", " ", "Brauer", " ", "Algebra", " ", "basis"}],
    "*)"}], "\[IndentingNewLine]",
   RowBox[{
    RowBox[{
     RowBox[{"WalledBrauerBasis", "[",
      RowBox[{"p_", ",", "q_"}], "]"}], ":=",
     RowBox[{
      RowBox[{"WalledBrauerBasis", "[",
       RowBox[{"p", ",", "q"}], "]"}], "=",
      RowBox[{
       RowBox[{
        RowBox[{"(",
         RowBox[{"SortB", "[",
          RowBox[{"B", "[",
           RowBox[{"Sequence", "@@", "#"}], "]"}], "]"}], ")"}], "&"}], "/@",

       RowBox[{"Map", "[",
        RowBox[{
         RowBox[{
          RowBox[{"FlipPair", "[",
           RowBox[{"#", ",", "p"}], "]"}], "&"}], ",",
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"FoldList", "[",
             RowBox[{
              RowBox[{
               RowBox[{"ReplacePart", "[",
                RowBox[{"#1", ",",
                 RowBox[{"#2", "->",
                  RowBox[{"{",
                   RowBox[{
                    RowBox[{"-", "#2"}], ",",
                    RowBox[{"#1", "[",
                    RowBox[{"[", "#2", "]"}], "]"}]}], "}"}]}]}], "]"}],
               "&"}], ",", "#", ",",
              RowBox[{"Range", "[",
               RowBox[{"p", "+", "q"}], "]"}]}], "]"}], "[",
            RowBox[{"[",
             RowBox[{"-", "1"}], "]"}], "]"}], "&"}], "/@",
          RowBox[{"Permutations", "[",
           RowBox[{"Range", "[",
            RowBox[{"p", "+", "q"}], "]"}], "]"}]}], ",",
         RowBox[{"{", "2", "}"}]}], "]"}]}]}]}], ";"}]}]}]], "Input",
 InitializationCell->
  True,ExpressionUUID->"e0ae4656-f20d-4371-b29a-8741e3d63d51"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ContractDiag", "[",
    RowBox[{"diag__", ",",
     RowBox[{"{",
      RowBox[{"l_", ",", "d_"}], "}"}]}], "]"}], ":=",
   RowBox[{"Module", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"new", ",", "data"}], "}"}], ",",
     RowBox[{
      RowBox[{"data", "=",
       RowBox[{"diag", "/.", "\[VeryThinSpace]",
        RowBox[{"B", "\[Rule]", "List"}]}]}], ";",
      RowBox[{"new", "=",
       RowBox[{"Sort", "[",
        RowBox[{"Flatten", "[",
         RowBox[{"Table", "[",
          RowBox[{
           RowBox[{"If", "[",
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
               "data", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
                "\[Intersection]",
               RowBox[{"{",
                RowBox[{
                 RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "\[NotEqual]",
              RowBox[{"{", "}"}]}], ",",
             RowBox[{"Complement", "[",
              RowBox[{
               RowBox[{
               "data", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
                ",",
               RowBox[{"{",
                RowBox[{
                 RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}], ",",
             RowBox[{"{", "}"}]}], "]"}], ",",
           RowBox[{"{",
            RowBox[{"i", ",", "1", ",",
             RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}], "]"}],
        "]"}]}], ";",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{"new", "\[Equal]",
         RowBox[{"{", "}"}]}], ",",
        RowBox[{"d", " ",
         RowBox[{"SortB", "[",
          RowBox[{"B", "[",
           RowBox[{"Sequence", "@@",
            RowBox[{"Sort", "[",
             RowBox[{"Table", "[",
              RowBox[{
               RowBox[{"If", "[",
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{
                   "data", "\[LeftDoubleBracket]", "i",
                    "\[RightDoubleBracket]"}], "\[Intersection]",
                   RowBox[{"{",
                    RowBox[{
                    RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "\[NotEqual]",
                  RowBox[{"{", "}"}]}], ",", "Nothing", ",",
                 RowBox[{
                 "data", "\[LeftDoubleBracket]", "i",
                  "\[RightDoubleBracket]"}]}], "]"}], ",",
               RowBox[{"{",
                RowBox[{"i", ",", "1", ",",
                 RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}],
             "]"}]}], "]"}], "]"}]}], ",",
        RowBox[{"SortB", "[",
         RowBox[{"B", "[",
          RowBox[{"Sequence", "@@",
           RowBox[{"Sort", "[",
            RowBox[{"Join", "[",
             RowBox[{
              RowBox[{"Table", "[",
               RowBox[{
                RowBox[{"If", "[",
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    "data", "\[LeftDoubleBracket]", "i",
                    "\[RightDoubleBracket]"}], "\[Intersection]",
                    RowBox[{"{",
                    RowBox[{
                    RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "\[NotEqual]",
                   RowBox[{"{", "}"}]}], ",", "Nothing", ",",
                  RowBox[{
                  "data", "\[LeftDoubleBracket]", "i",
                   "\[RightDoubleBracket]"}]}], "]"}], ",",
                RowBox[{"{",
                 RowBox[{"i", ",", "1", ",",
                  RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}], ",",
              RowBox[{"{", "new", "}"}]}], "]"}], "]"}]}], "]"}], "]"}]}],
       "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{
   RowBox[{"ContractOne", "[",
    RowBox[{"x_", ",",
     RowBox[{"{",
      RowBox[{"l_", ",", "d_"}], "}"}]}], "]"}], ":=",
   RowBox[{"x", "/.", "\[VeryThinSpace]",
    RowBox[{
     RowBox[{"B", "[", "lst__", "]"}], "\[RuleDelayed]",
     RowBox[{"ContractDiag", "[",
      RowBox[{
       RowBox[{"{", "lst", "}"}], ",",
       RowBox[{"{",
        RowBox[{"l", ",", "d"}], "}"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{
   RowBox[{"Contract", "[",
    RowBox[{"x_", ",", "lst_List", ",", "d_"}], "]"}], ":=",
   RowBox[{"Fold", "[",
    RowBox[{"ContractOne", ",", "x", ",",
     TemplateBox[{
       RowBox[{"{",
         RowBox[{"lst", ",",
           RowBox[{"ConstantArray", "[",
             RowBox[{"d", ",",
               RowBox[{"Length", "[", "lst", "]"}]}], "]"}]}], "}"}]},
      "Transpose"]}], "]"}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{
   RowBox[{"FullContract", "[",
    RowBox[{"x_", ",", "p_", ",", "q_", ",", "d_"}], "]"}], ":=",
   RowBox[{
    RowBox[{"Contract", "[",
     RowBox[{"x", ",",
      RowBox[{"Table", "[",
       RowBox[{"i", ",",
        RowBox[{"{",
         RowBox[{"i", ",",
          RowBox[{"p", "+", "q"}]}], "}"}]}], "]"}], ",", "d"}], "]"}], "/.",
    "\[VeryThinSpace]",
    RowBox[{
     RowBox[{"B", "[", "]"}], "\[Rule]", "1"}]}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{
   RowBox[{"ContractOne2", "[",
    RowBox[{"x_", ",",
     RowBox[{"{",
      RowBox[{"l_", ",", "d_"}], "}"}], ",", "p_", ",", "q_"}], "]"}], ":=",
   RowBox[{"If", "[",
    RowBox[{
     RowBox[{"l", ">",
      RowBox[{"p", "+", "q"}]}], ",",
     RowBox[{"x", "/.", "\[VeryThinSpace]",
      RowBox[{
       RowBox[{
        RowBox[{"B", "[", "left___", "]"}], "\[TensorProduct]",
        RowBox[{"B", "[", "right___", "]"}]}], "\[RuleDelayed]",
       RowBox[{
        RowBox[{"B", "[", "left", "]"}], "\[TensorProduct]",
        RowBox[{"ContractDiag", "[",
         RowBox[{
          RowBox[{"{", "right", "}"}], ",",
          RowBox[{"{",
           RowBox[{
            RowBox[{"l", "-", "p", "-", "q"}], ",", "d"}], "}"}]}],
         "]"}]}]}]}], ",",
     RowBox[{"x", "/.", "\[VeryThinSpace]",
      RowBox[{
       RowBox[{
        RowBox[{"B", "[", "left___", "]"}], "\[TensorProduct]",
        RowBox[{"B", "[", "right___", "]"}]}], "\[RuleDelayed]",
       RowBox[{
        RowBox[{"ContractDiag", "[",
         RowBox[{
          RowBox[{"{", "left", "}"}], ",",
          RowBox[{"{",
           RowBox[{"l", ",", "d"}], "}"}]}], "]"}], "\[TensorProduct]",
        RowBox[{"B", "[", "right", "]"}]}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{
   RowBox[{"ContractOne2", "[",
    RowBox[{"x_", ",", "ld_"}], "]"}], ":=",
   RowBox[{"ContractOne2", "[",
    RowBox[{"x", ",", "ld", ",", "p", ",", "q"}], "]"}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{
   RowBox[{"Contract2", "[",
    RowBox[{"x_", ",", "lst_List", ",", "d_", ",", "p_", ",", "q_"}], "]"}], ":=",
   RowBox[{
    RowBox[{"Fold", "[",
     RowBox[{
      RowBox[{
       RowBox[{"ContractOne2", "[",
        RowBox[{"#1", ",", "#2", ",", "p", ",", "q"}], "]"}], "&"}], ",", "x",
       ",",
      TemplateBox[{
        RowBox[{"{",
