            RowBox[{"p", "+", "q"}], ")"}], "!"}]}], "}"}]}], "]"}]}]}],
    ";"}], "\[IndentingNewLine]",
   RowBox[{
    RowBox[{
     RowBox[{"contractTensor", "[",
      RowBox[{"p_", ",", "q_", ",", "d_", ",", "lst_"}], "]"}], ":=",
     RowBox[{
      RowBox[{"contractTensor", "[",
       RowBox[{"p", ",", "q", ",", "d", ",", "lst"}], "]"}], "=",
      RowBox[{
       RowBox[{"Table", "[",
        RowBox[{
         RowBox[{
          RowBox[{"(",
           RowBox[{
            RowBox[{"Contract", "[",
             RowBox[{
              RowBox[{
               RowBox[{"WalledBrauerBasis", "[",
                RowBox[{"p", ",", "q"}], "]"}], "[",
               RowBox[{"[", "i", "]"}], "]"}], ",", "lst", ",", "d"}], "]"}],
            "/.",
            RowBox[{"{",
             RowBox[{"(",
              RowBox[{
               RowBox[{"B", "[", "y__", "]"}], ":>",
               RowBox[{"B", "[",
                RowBox[{"Sequence", "@@",
                 RowBox[{"(",
                  RowBox[{
                   RowBox[{"{", "y", "}"}], "/.",
                   RowBox[{"Flatten", "[",
                    RowBox[{
                    RowBox[{
                    RowBox[{"{",
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[",
                    RowBox[{"[", "1", "]"}], "]"}], "->",
                    RowBox[{"#", "[",
                    RowBox[{"[", "2", "]"}], "]"}]}], ",",
                    RowBox[{
                    RowBox[{"-",
                    RowBox[{"#", "[",
                    RowBox[{"[", "1", "]"}], "]"}]}], "->",
                    RowBox[{"-",
                    RowBox[{"#", "[",
                    RowBox[{"[", "2", "]"}], "]"}]}]}]}], "}"}], "&"}], "/@",

                    RowBox[{"(",
                    RowBox[{
                    RowBox[{"{",
                    RowBox[{
                    RowBox[{"Complement", "[",
                    RowBox[{
                    RowBox[{"Range", "[",
                    RowBox[{"p", "+", "q"}], "]"}], ",", "lst"}], "]"}], ",",

                    RowBox[{"Range", "[",
                    RowBox[{"p", "+", "q", "-",
                    RowBox[{"Length", "[", "lst", "]"}]}], "]"}]}], "}"}],
                    "\[Transpose]"}], ")"}]}], "]"}]}], ")"}]}], "]"}]}],
              ")"}], "}"}]}], ")"}], "\[IndentingNewLine]", "/.",
          RowBox[{"{",
           RowBox[{
            RowBox[{
             RowBox[{"B", "[", "]"}], ":>", "1"}], ",",
            RowBox[{
             RowBox[{"B", "[", "arg__", "]"}], ":>",
             RowBox[{"SparseArray", "[",
              RowBox[{
               RowBox[{
                RowBox[{"{",
                 RowBox[{
                  RowBox[{"Position", "[",
                   RowBox[{
                    RowBox[{"WalledBrauerBasis", "[",
                    RowBox[{
                    RowBox[{"p", "-",
                    RowBox[{"Count", "[",
                    RowBox[{"lst", ",",
                    RowBox[{"x_", "/;",
                    RowBox[{"x", "<=", "p"}]}]}], "]"}]}], ",",
                    RowBox[{"q", "-",
                    RowBox[{"Count", "[",
                    RowBox[{"lst", ",",
                    RowBox[{"x_", "/;",
                    RowBox[{"x", ">", "p"}]}]}], "]"}]}]}], "]"}], ",",
                    RowBox[{"B", "[", "arg", "]"}], ",",
                    RowBox[{"{", "1", "}"}]}], "]"}], "[",
                  RowBox[{"[",
                   RowBox[{"1", ",", "1"}], "]"}], "]"}], "}"}], "->", "1"}],
               ",",
               RowBox[{
                RowBox[{"(",
                 RowBox[{"p", "+", "q", "-",
                  RowBox[{"Length", "[", "lst", "]"}]}], ")"}], "!"}]}],
              "]"}]}]}], "}"}]}], ",",
         RowBox[{"{",
          RowBox[{"i", ",", "1", ",",
           RowBox[{
            RowBox[{"(",
             RowBox[{"p", "+", "q"}], ")"}], "!"}]}], "}"}]}], "]"}],
       "\[Transpose]"}]}]}], ";"}], "\[IndentingNewLine]",
   RowBox[{"(*", " ",
    RowBox[{"Auxiliary", " ", "tensors"}], " ", "*)"}], "\[IndentingNewLine]",
   RowBox[{
    RowBox[{
     RowBox[{"mulTensorMatrix", "[",
      RowBox[{"p_", ",", "q_", ",", "d_"}], "]"}], ":=",
