       "Transpose"]}], "]"}], "/.", "\[VeryThinSpace]",
    RowBox[{
     RowBox[{"B", "[", "]"}], "\[Rule]", "1"}]}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{
