       RowBox[{"p", ",", "q", ",", "d"}], "]"}], "=",
      RowBox[{"Flatten", "[",
       RowBox[{
        RowBox[{"mulTensor", "[",
         RowBox[{"p", ",", "q", ",", "d"}], "]"}], ",",
        RowBox[{"{",
         RowBox[{
          RowBox[{"{",
           RowBox[{"1", ",", "2"}], "}"}], ",",
          RowBox[{"{", "3", "}"}]}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]",
   RowBox[{
    RowBox[{"MulContractTensor", "[",
     RowBox[{"p_", ",", "q_", ",", "d_"}], "]"}], ":=",
    RowBox[{
     RowBox[{"MulContractTensor", "[",
      RowBox[{"p", ",", "q", ",", "d"}], "]"}], "=",
