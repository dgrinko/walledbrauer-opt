Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ",
   RowBox[{
   "Multiply", " ", "two", " ", "Brauer", " ", "algebra", " ", "diagrams"}],
   " ", "*)"}], "\[IndentingNewLine]",
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"MultiplyPair2", "[",
      RowBox[{"\[Sigma]1_", ",", "\[Sigma]2_", ",", "d_"}], "]"}], ":=",
     RowBox[{
      RowBox[{"MultiplyPair2", "[",
       RowBox[{"\[Sigma]1", ",", "\[Sigma]2", ",", "d"}], "]"}], "=",
      RowBox[{"Module", "[",
       RowBox[{
        RowBox[{"{",
         RowBox[{
         "lst", ",", "i", ",", "new", ",", "pos", ",", "\[Sigma]1n", ",",
          "\[Sigma]2n"}], "}"}], ",", "\[IndentingNewLine]",
        RowBox[{
         RowBox[{"\[Sigma]1n", "=",
          RowBox[{"Map", "[",
           RowBox[{
            RowBox[{
             RowBox[{"If", "[",
              RowBox[{
               RowBox[{"#", "<", "0"}], ",",
               SubscriptBox["b",
                RowBox[{"-", "#"}]], ",",
               SubscriptBox["a", "#"]}], "]"}], "&"}], ",",
            RowBox[{"List", "@@", "\[Sigma]1"}], ",",
            RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]",
         RowBox[{"\[Sigma]2n", "=",
          RowBox[{"Map", "[",
           RowBox[{
            RowBox[{
             RowBox[{"If", "[",
              RowBox[{
               RowBox[{"#", "<", "0"}], ",",
               SubscriptBox["b",
                RowBox[{"-", "#"}]], ",",
               SubscriptBox["a", "#"]}], "]"}], "&"}], ",",
            RowBox[{"List", "@@", "\[Sigma]2"}], ",",
            RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]",
         RowBox[{"(*", " ",
          RowBox[{
          "Denote", " ", "the", " ", "nodes", " ", "in", " ", "the", " ",
           "middle", " ", "layer", " ", "by", " ", "x"}], " ", "*)"}],
         "\[IndentingNewLine]",
         RowBox[{"lst", "=",
          RowBox[{"Join", "[",
           RowBox[{
            RowBox[{"\[Sigma]1n", "/.",
             RowBox[{"b", "->", "x"}]}], ",",
            RowBox[{"\[Sigma]2n", "/.",
             RowBox[{"a", "->", "x"}]}]}], "]"}]}], ";",
         "\[IndentingNewLine]",
         RowBox[{"(*", " ",
          RowBox[{"Treat", " ", "each", " ", "node", " ",
           SubscriptBox["x", "i"], " ", "in", " ", "the", " ", "intermediate",
            " ", "level"}], " ", "*)"}], "\[IndentingNewLine]",
         RowBox[{"Do", "[", "\[IndentingNewLine]",
          RowBox[{"(*", " ",
           RowBox[{"Find", " ", "all", " ", "edges", " ", "containing", " ",
            SubscriptBox["x", "i"]}], " ", "*)"}], "\[IndentingNewLine]",
          RowBox[{
           RowBox[{
            RowBox[{"new", "=",
             RowBox[{"lst", "\[LeftDoubleBracket]",
              RowBox[{"pos", "=",
               RowBox[{
                RowBox[{"Position", "[",
                 RowBox[{"lst", ",",
                  SubscriptBox["x", "i"], ",",
                  RowBox[{"{", "2", "}"}]}], "]"}], "\[LeftDoubleBracket]",
                RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}]}],
              "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]",
            RowBox[{"(*", " ",
             RowBox[{
             "Update", " ", "the", " ", "list", " ", "by", " ", "removing", " ",
               "these", " ", "edges", " ", "and", " ", "adding", " ", "a", " ",
               "new", " ", "one"}], " ", "*)"}], "\[IndentingNewLine]",
            RowBox[{"lst", "=",
             RowBox[{"Append", "[",
              RowBox[{
               RowBox[{"Delete", "[",
                RowBox[{"lst", ",",
                 RowBox[{"List", "/@", "pos"}]}], "]"}], ",",
               RowBox[{"DeleteCases", "[",
                RowBox[{
                 RowBox[{"Join", "@@", "new"}], ",",
                 SubscriptBox["x", "i"]}], "]"}]}], "]"}]}], ";"}],
           "\[IndentingNewLine]", ",",
           RowBox[{"{",
            RowBox[{"i", ",", "1", ",",
             RowBox[{"Length", "[", "\[Sigma]1", "]"}]}], "}"}]}],
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]",
         RowBox[{"(*", " ",
          RowBox[{
          "Output", " ", "the", " ", "new", " ", "Brauer", " ", "diagram"}],
          " ", "*)"}], "\[IndentingNewLine]",
         RowBox[{"{",
          RowBox[{
           RowBox[{"B", "@@",
            RowBox[{"SortB", "@",
             RowBox[{"Map", "[",
              RowBox[{
               RowBox[{
                RowBox[{"If", "[",
                 RowBox[{
                  RowBox[{"TrueQ", "[",
                   RowBox[{
                    RowBox[{"First", "[", "#", "]"}], "==", "b"}], "]"}], ",",
                  RowBox[{"-",
                   RowBox[{"Part", "[",
                    RowBox[{"#", ",", "2"}], "]"}]}], ",",
                  RowBox[{"Part", "[",
                   RowBox[{"#", ",", "2"}], "]"}]}], "]"}], "&"}], ",",
               RowBox[{"DeleteCases", "[",
                RowBox[{"lst", ",",
                 RowBox[{"{", "}"}]}], "]"}], ",",
               RowBox[{"{", "2", "}"}]}], "]"}]}]}], ",",
           RowBox[{"d", "^",
            RowBox[{"Count", "[",
             RowBox[{"lst", ",",
              RowBox[{"{", "}"}]}], "]"}]}]}], "}"}]}]}],
       "\[IndentingNewLine]", "]"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]",
   RowBox[{
    RowBox[{"MultiplyPair", "[",
     RowBox[{"\[Sigma]1_", ",", "\[Sigma]2_", ",", "d_"}], "]"}], ":=",
    RowBox[{"Times", "@@",
     RowBox[{"MultiplyPair2", "[",
      RowBox[{"\[Sigma]1", ",", "\[Sigma]2", ",", "d"}],
      "]"}]}]}]}]}]], "Input",
 InitializationCell->
  True,ExpressionUUID->"e268c0c0-2006-4f11-aadc-f4e043e505f4"]
