Notebook[{

Cell[CellGroupData[{
Cell["Asymmetric 1 \[RightArrow] 3 quantum cloning", "Title",ExpressionUUID->"633a1f1a-5eb8-4597-9e0f-75f7057a722c"],

Cell["\<\
Section 7.3 \[CenterDot] Examples 7.2\[Dash]7.3 \[CenterDot] Equations (159)\
\[Dash](169) \[CenterDot] Figures 6\[Dash]7\
\>", "Subtitle",ExpressionUUID->"cb53d02d-4910-47f8-83a2-60c6ec2b5af7"],

Cell["\<\
Construct the unitary-equivariant cloning SDP for qubits (d = 2) or qutrits \
(d = 3). The variables p\:2081, p\:2082, p\:2083 are depolarizing (shrinking) \
coefficients, as in equation (159), not clone fidelities. The corresponding \
pure-state fidelity is F\:1d62 = [1 + (d \[Minus] 1)p\:1d62]/d. All Choi \
matrices below have trace d.\
\>", "Text",ExpressionUUID->"4c21eaee-984d-4a45-ab60-63b025970153"],

Cell["\<\
Evaluate the notebook from the top. The exact block construction uses \
normalized intertwiners (Appendix D, equations (249)\[Dash](252)), so it does \
not depend on accidental alignment of independently chosen eigenvectors. \
Coordinates within a block may differ from the printed examples by an \
orthogonal basis change; the SDP and its feasible shrinking coefficients are \
unchanged.\
\>", "Text",ExpressionUUID->"36e9c31b-5ad9-43bb-bb97-23ba935c1787"],

Cell[CellGroupData[{

Cell["1. Parameters and expected results", "Section",ExpressionUUID->"a16b695b-b296-4c6d-9591-baf3b1e4b8c3"],

Cell["\<\
{p, q, d} = {1, 3, 2};
makePlots = False;
runAnalyticExamples = False;
If[!MemberQ[{2, 3}, d], Print[\"Choose d = 2 or d = 3.\"]; Abort[]];\
\>", "Input",
 CellTags->
  "app3-parameters",ExpressionUUID->"66befcf5-51c4-4eec-a0dc-4110828b5f44"],

Cell["\<\
At the symmetric optimum p\:2081 = p\:2082 = p\:2083 = (d + 3)/[3(d + 1)]: p\
\:1d62 = 5/9 and F\:1d62 = 7/9 for d = 2; p\:1d62 = 1/2 and F\:1d62 = 2/3 for \
d = 3. The default run builds and checks the general asymmetric SDP. Set \
makePlots = True for numerical region plots. The final optional analytic \
example applies only to d = 2.\
\>", "Text",ExpressionUUID->"2c3f265f-2a51-43c3-a637-f9bbf0d8d774"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Diagram and matrix utilities", "Section",ExpressionUUID->"fe3907d8-e794-4664-82d6-94c960466217"],

Cell["\<\
Read the primitive idempotents from the Sage database. A diagram acts on (\
\:2102\:1d48)\[CircleTimes]\:2074; the representation below uses the original \
notebook\[CloseCurlyQuote]s transposed-diagram convention consistently. The \
primitive projectors and the positivity/partial-trace constraints are \
unaffected by that convention.\
\>", "Text",ExpressionUUID->"00ef3980-7945-486d-906c-dbb50db6655a"],

Cell["\<\
s[p_, q_, d_] :=
  s[p, q, d] =
   If[d >= p + q,
    Import[NotebookDirectory[] <> \"wba_idempotents_db/primitive_\" <>
      ToString[p] <> \"_\" <> ToString[q] <> \".txt\"],
    Import[NotebookDirectory[] <> \"wba_idempotents_db/primitive_\" <>
      ToString[p] <> \"_\" <> ToString[q] <> \"_\" <> ToString[d] <>
      \".txt\"]];

(* Parse Sage output into Mathematica *)
Parse[s_] := Module[{t, \\[Lambda]s, \\[CurlyEpsilon]s},
   (* Remove the first and last curly brace *)
   t = StringTake[s, {2, -2}];
   (* Fix the brackets of B *)
   t = StringReplace[t, {\"{{\" -> \"[{\", \"}}\" -> \"}]\"}];
   (* Add path-label colons and convert curly braces *)
   t = StringReplace[
     t, {\"(([\" -> \":{{[\", \"([\" -> \"{[\", \"]))\" -> \"]}}\", \"])\" -> \
\"]}\"}];
   (* Replace []->{} and [1,2]->{1,2} *)
   t = StringReplace[t, {\"[]\" -> \"{}\"}];
   t = StringReplace[
     t, {StringExpression[\"[\", i : NumberString] :> \"{\" ~~ i}];
   t = StringReplace[
     t, {StringExpression[i : NumberString, \"]\"] :> i ~~ \"}\"}];
   (* Remove commas after idempotents *)
   t = StringReplace[t, \", :\" -> \" : \"];
   (* Split the string at colons *)
   t = StringSplit[t, \":\"];
   (* Mathematica expression *)
   t = ToExpression[t];
   (* Final vertex on a path and its idempotent *)
   {\\[Lambda]s, \\[CurlyEpsilon]s} = Partition[t, 2]\\[Transpose];
   \\[Lambda]s = Last /@ \\[Lambda]s;
   {\\[Lambda]s, \\[CurlyEpsilon]s}
   ];\
\>", "Input",
 CellTags->
  "app3-data-loader",ExpressionUUID->"f06ddec4-85a1-4132-8d56-33eaa8abc53d"],

Cell["\<\
(* Elementary rank-1 matrix *)
ketbra[s_, t_, {p_, q_, d_}] :=
 SparseArray[{{FromDigits[s, d], FromDigits[t, d]} + 1 -> 1}, {d^(
   p + q), d^(p + q)}]

(* Converts a diagram into a Matrix *)
\\[Psi][diagram__, {p_, q_, d_}] := \\[Psi][diagram, {p, q, d}] =
   Module[{\\[Delta], ip, in, is, range, s},
    \\[Delta] =
     Times @@ (KroneckerDelta[i[#[[1]]], i[#[[2]]]] & /@ {diagram});
    ip = Table[i[k], {k, p + q}];
    in = Table[i[-k], {k, p + q}];
    is = Join[in, ip];
    range = Sequence @@ ({#, 0, d - 1} & /@ is);
    Sum[\\[Delta]*ketbra[in, ip, {p, q, d}], Evaluate[range]]
    ];

(* Converts a linear combination of diagrams into a matrix *)
ToMatrix[lst_List, pqd_] := ToMatrix[#, pqd] & /@ lst;
ToMatrix[expr_, {p_, q_, d_}] :=
  Normal[expr /. B[lst__] :> \\[Psi][lst, {p, q, d}]] /. z -> d;\
\>", "Input",
 CellTags->
  "app3-diagram-map",ExpressionUUID->"12331d0e-3014-4245-9a9c-5115161f6ab6"],

Cell["\<\
(* Finds the 1-eigenvectors of a projector *)
Vecs[M_] := Module[{\\[Lambda]s, vs},
   {\\[Lambda]s, vs} = Eigensystem@M;
   Orthogonalize@Pick[vs, \\[Lambda]s, 1]
   ];

(* Direct sum of a list of matrices *)
DirectSum[lst_] :=
  ArrayFlatten@ReleaseHold@DiagonalMatrix[Hold /@ lst];
(* Big SWAP *)
SWAP[dAs_List, dBs_List] := DirectSum[SWAP @@@ ({dAs, dBs}\\[Transpose])];
(* Swaps systems of dimension dA and dB *)
SWAP[0, _] = Nothing;
SWAP[_, 0] = Nothing;
SWAP[dA_, dB_] :=
  SparseArray[
   Join @@ Table[{a + b*dA, a*dB + b} + 1 -> 1, {a, 0, dA - 1}, {b, 0,
       dB - 1}], {dA*dB, dA*dB}];

(* Extract one of each blocks in Schur basis *)
Blocks[S_, {dB_, dU_}] := Module[{pivot, len, runs},
   pivot =
    Prepend[Most@Accumulate[Times @@@ ({dB, dU}\\[Transpose])], 0];
   len = Range /@ dB;
   runs = pivot + len;
   S[[#, #]] & /@ runs
   ];\
\>", "Input",
 CellTags->
  "app3-block-utils",ExpressionUUID->"5c2dd182-afad-40b8-9cf0-d497c7b0fcc6"],

Cell["\<\
SortB[diagram_] := Sort[Map[Sort, diagram, 1]];
FlipPair[pair_, wall_] := Sort[If[Abs[#] > wall, -#, #] & /@ pair];
WalledBrauerBasis[left_, right_] := B[Sequence @@ #] & /@
  Map[FlipPair[#, left] &,
    (Last[FoldList[ReplacePart[#1, #2 -> {-#2, #1[[#2]]}] &, #,
       Range[left + right]]] & /@ Permutations[Range[left + right]]), {2}];
zeroMatrixQ[matrix_] := And @@ (TrueQ[# == 0] & /@ \
Flatten[Simplify[matrix]]);
require[condition_, message_] := If[!TrueQ[condition],
  Print[\"Check failed: \", message]; Abort[]];\
\>", "Input",
 CellTags->
  "app3-basis-utils",ExpressionUUID->"1a14427e-a47a-443a-b730-01ca42d08459"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Aligned irreducible blocks", "Section",ExpressionUUID->"35caa0b2-0051-4cd6-ace7-a7778ca10919"],

Cell["\<\
For each irreducible component, choose one orthonormal basis of a reference \
primitive projector. Transport this entire basis to every other path through \
a nonzero operator \[CapitalPi]\:1d62 B \[CapitalPi]ref, normalized by its \
Hilbert\[Dash]Schmidt norm. Such an intertwiner acts as the identity on the \
unitary register up to its scalar coefficient. A deterministic search over \
the diagram basis finds a nonzero coupling; failed couplings are skipped.\
\>", "Text",ExpressionUUID->"ebae6a56-e6d9-4e2f-b1da-b3510f9b45f1"],

Cell["\<\
{labels, idempotents} = Parse[s[p, q, d]];
Bs2 = SortB /@ WalledBrauerBasis[p, q];
diagramMatrices = ToMatrix[Bs2, {p, q, d}];
projectors = ToMatrix[idempotents, {p, q, d}];
pathGroups = GatherBy[Range[Length[labels]], labels[[#]] &];
pathGroups = Select[pathGroups, MatrixRank[projectors[[First[#]]]] > 0 &];
pathGroups = pathGroups[[Ordering[Length /@ pathGroups]]];
dB = Length /@ pathGroups;
dU = MatrixRank[projectors[[First[#]]]] & /@ pathGroups;
require[dB.dU == d^(p + q),
  \"the block dimensions must sum to the Hilbert-space dimension\"];

alignedPathBases[group_] := Module[
  {reference, referenceBasis, rank, transport, bridge, normSquared},
  reference = projectors[[First[group]]];
  referenceBasis = Vecs[reference];
  rank = Length[referenceBasis];
  Table[
    If[index == First[group], referenceBasis,
      transport = Missing[\"NoCoupling\"];
      Do[
        bridge = projectors[[index]].diagramMatrix.reference;
        normSquared = Simplify[Total[Abs[Flatten[bridge]]^2]/rank];
        If[TrueQ[normSquared > 0],
          transport = bridge/Sqrt[normSquared]; Break[]],
        {diagramMatrix, diagramMatrices}];
      require[!MissingQ[transport],
        \"a nonzero intertwiner must exist for every path\"];
      Simplify[referenceBasis.ConjugateTranspose[transport]]],
    {index, group}]
];
U = Join @@ Flatten[alignedPathBases /@ pathGroups, 1];
P = SWAP[dB, dU];
toBlocks[matrix_] :=
  Blocks[P.U.matrix.ConjugateTranspose[U].Transpose[P], {dB, dU}];
M = Sum[b[index] diagramMatrices[[index]], {index, Length[Bs2]}];
S = Simplify[P.U.M.ConjugateTranspose[U].Transpose[P]];
blocks = Simplify[toBlocks[M]];\
\>", "Input",
 CellTags->
  "app3-aligned-blocks",ExpressionUUID->"2cff783b-eca2-4b7c-92f8-\
652ba1c61704"],

Cell["\<\
The next exact identities verify the full block decomposition, not just one \
random product. After swapping the two representation registers, S must equal \
the direct sum of I_(dU) \[CircleTimes] X. This proves that positivity of the \
extracted blocks is equivalent to positivity of the full Choi matrix.\
\>", "Text",ExpressionUUID->"3bc6637a-5abc-435d-bb53-6857abd9b904"],

Cell[CellGroupData[{

Cell["\<\
unitaryCheck = zeroMatrixQ[U.ConjugateTranspose[U] -
  IdentityMatrix[d^(p + q)]];
factorizationCheck = zeroMatrixQ[S - DirectSum[
  MapThread[KroneckerProduct[IdentityMatrix[#1], #2] &, {dU, blocks}]]];
require[unitaryCheck && factorizationCheck,
  \"the aligned block map must reconstruct every diagram combination\"];
blockSummary = Association[\"Block sizes\" -> dB,
  \"Unitary multiplicities\" -> dU,
  \"Orthonormal basis\" -> unitaryCheck,
    \"Exact block factorization\" -> factorizationCheck];
blockSummary\
\>", "Input",
 CellTags->
  "app3-block-check",ExpressionUUID->"1c64d956-bf4c-4b25-a31a-4e5c315e096a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]",
  RowBox[{
   RowBox[{"\<\"Block sizes\"\>", "\[Rule]",
    RowBox[{"{",
     RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], ",",
   RowBox[{"\<\"Unitary multiplicities\"\>", "\[Rule]",
    RowBox[{"{",
     RowBox[{"5", ",", "1", ",", "3"}], "}"}]}], ",",
   RowBox[{"\<\"Orthonormal basis\"\>", "\[Rule]", "True"}], ",",
   RowBox[{"\<\"Exact block factorization\"\>", "\[Rule]", "True"}]}],
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"4d498a1f-94dc-4d7a-b22d-\
d6ab59928a78"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Output-permutation symmetry, in the same basis", "Subsection",ExpressionUUID->"0fc0f8ac-20aa-436f-905b-691f79fb5581"],

Cell["\<\
The adjacent output swaps generate S\:2083. Their blocks are computed in the \
current aligned basis, for either dimension. Commuting with these blocks \
describes the permutation-symmetric subclass; these extra equalities are not \
imposed on the general asymmetric cloning SDP below.\
\>", "Text",ExpressionUUID->"4742d27f-67e3-4975-a325-286e91a54be2"],

Cell[CellGroupData[{

Cell["\<\
swapDiagram[first_, second_] := B[Sequence @@ Sort[
  Table[Sort[{-index, Which[index == first, second, index == second,
    first, True, index]}],
    {index, p + q}]]];
spq = Table[Simplify[toBlocks[ToMatrix[swapDiagram[p + index,
  p + index + 1], {p, q, d}]]],
  {index, q - 1}];
require[And @@ Flatten[Table[Dimensions[spq[[generator,
  block]]] == {dB[[block]], dB[[block]]},
  {generator, Length[spq]}, {block, Length[dB]}]],
    \"output-swap blocks must have the current block sizes\"];
symmetricEquations = DeleteDuplicates[Flatten[Table[
  blocks[[block]].spq[[generator, block]] - spq[[generator,
    block]].blocks[[block]],
  {generator, Length[spq]}, {block, Length[blocks]}]]];
symmetricRules = Quiet[First[Solve[Thread[symmetricEquations == 0],
  Variables[blocks]]], Solve::svars];
symmetryCheck = zeroMatrixQ[symmetricEquations /. symmetricRules];
require[symmetryCheck,
  \"the derived output-symmetry equations must be consistent\"];
Association[\"Output generators\" -> Length[spq],
  \"Symmetry equations verified\" -> symmetryCheck]\
\>", "Input",
 CellTags->
  "app3-output-symmetry",ExpressionUUID->"6820515f-a977-48f2-8ed9-\
290b6e5b814d"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]",
  RowBox[{
   RowBox[{"\<\"Output generators\"\>", "\[Rule]", "2"}], ",",
   RowBox[{"\<\"Symmetry equations verified\"\>", "\[Rule]", "True"}]}],
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"a04f5e2d-99ed-4571-9a16-\
4bde6896f9e7"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. The asymmetric cloning SDP", "Section",ExpressionUUID->"a68bc951-9dd6-45a4-91ec-d455bb9525da"],

Cell["\<\
The diagram matrices are real. Restricting the Choi matrix to be real \
symmetric loses no attainable shrinking coefficients: averaging a feasible \
matrix with its complex conjugate preserves positivity, normalization and the \
real marginals. Eliminate the linear symmetry equations before constructing \
the semidefinite constraints. Unitary covariance then reduces trace \
preservation to Tr M = d.\
\>", "Text",ExpressionUUID->"f1b1c6e0-abd1-486c-959f-c54462d73ffe"],

Cell["\<\
hermitianEquations = DeleteDuplicates[Flatten[M - Transpose[M]]];
hermitianRules = Quiet[First[Solve[Thread[hermitianEquations == 0],
  Variables[M]]], Solve::svars];
realChoi = Simplify[M /. hermitianRules];
realBlocks = Simplify[blocks /. hermitianRules];
require[zeroMatrixQ[realChoi - Transpose[realChoi]],
  \"the optimization matrix must be real symmetric\"];

partialTrace = ResourceFunction[\"MatrixPartialTrace\"];
shrinkage = Table[Simplify[(d partialTrace[realChoi, Except[{1,
  index + 1}], d][[1, 1]] - 1)/(d - 1)],
  {index, q}];
vars = Variables[realBlocks];
PSDconstraints = (VectorGreaterEqual[{#, 0}, {\"SemidefiniteCone\",
  Length[#]}] & /@ realBlocks);
normalizationConstraint = Tr[realChoi] == d;
baseConstraints = Flatten[{PSDconstraints, normalizationConstraint}];\
\>", "Input",
 CellTags->
  "app3-model",ExpressionUUID->"3ad5fce2-a5a6-4090-95b0-1c9803d326a7"],

Cell["\<\
MatrixPartialTrace is obtained from the Wolfram Function Repository and \
requires access on its first use. The scalar objective below maximizes the \
average shrinking coefficient. By output-permutation symmetry this optimum \
can be attained with all three coefficients equal. Feasibility classification \
below checks the returned primal matrices and marginal residuals, including \
after a partial-success solver status; an objective value alone is \
insufficient.\
\>", "Text",ExpressionUUID->"f3f543cc-2e04-4501-925f-41fdfbc3f534"],

Cell[CellGroupData[{

Cell["\<\
feasibilityTolerance = 10^-7;
Clear[cloneFeasibility, cloneWitnessQ];
finiteRealQ[value_] := NumberQ[value] && TrueQ[Im[value] == 0];
cloneWitnessQ[rules_List, point_List] := Module[
  {numericBlocks, eigenvalues, traceResidual, marginalResidual},
  numericBlocks = N[realBlocks /. rules];
  If[!And @@ (MatrixQ[#, finiteRealQ] & /@ numericBlocks),
    Return[False]];
  eigenvalues = Flatten[Eigenvalues /@ numericBlocks];
  traceResidual = Abs[N[Tr[realChoi /. rules] - d]];
  marginalResidual = Max[Abs[N[(shrinkage /. rules) - point]]];
  TrueQ[Min[eigenvalues] >= -feasibilityTolerance &&
    traceResidual <= feasibilityTolerance &&
    marginalResidual <= feasibilityTolerance]
];
cloneFeasibility[point_List /; Length[point] == q &&
  VectorQ[point, NumericQ]] := cloneFeasibility[point] = Module[
  {solution, rules},
  solution = Quiet[SemidefiniteOptimization[0,
    Join[baseConstraints, Thread[shrinkage == point]], vars,
    {\"PrimalMinimumValue\", \"PrimalMinimizerRules\"}],
    {SemidefiniteOptimization::nsolc}];
  If[!MatchQ[solution, {_, _List}], Return[Indeterminate]];
  If[First[solution] === Infinity, Return[Infinity]];
  rules = Last[solution];
  If[TrueQ[Abs[First[solution]] <= feasibilityTolerance] &&
    cloneWitnessQ[rules, point], 0, Indeterminate]
];
cloneFeasibleQ[x_?NumericQ, y_?NumericQ, z_?NumericQ] :=
  TrueQ[cloneFeasibility[{x, y, z}] == 0];
maximumAverageShrinkage = -SemidefiniteOptimization[-Total[shrinkage]/q,
  baseConstraints, vars, \"PrimalMinimumValue\"];
expectedSymmetricShrinkage = (d + q)/(q (d + 1));
symmetricFeasible =
  cloneFeasibility[ConstantArray[expectedSymmetricShrinkage, q]];
outsideFeasible =
  cloneFeasibility[ConstantArray[expectedSymmetricShrinkage + 1/20, q]];
require[Abs[maximumAverageShrinkage - expectedSymmetricShrinkage] < 10^-7,
  \"the symmetric optimum must agree with the universal cloner\"];
require[NumericQ[symmetricFeasible] && Abs[symmetricFeasible] < 10^-7 &&
  outsideFeasible === Infinity,
  \"the SDP must accept the boundary point and reject the point beyond it\"];
cloneSummary = Association[\"Dimension\" -> d,
  \"Symmetric shrinking coefficient\" -> maximumAverageShrinkage,
  \"Exact expected coefficient\" -> expectedSymmetricShrinkage,
  \"Single-clone pure-state fidelity\" -> (1 + (d -
    1) expectedSymmetricShrinkage)/d,
  \"Exact block check\" -> factorizationCheck,
    \"Symmetry check\" -> symmetryCheck,
  \"Boundary witness checked\" -> True, \"Boundary feasible\" -> True,
    \"Outside point infeasible\" -> True];
cloneSummary\
\>", "Input",
 CellTags->
  "app3-summary",ExpressionUUID->"cec20a25-e92a-4b2e-85c2-2ac671b3695e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]",
  RowBox[{
   RowBox[{"\<\"Dimension\"\>", "\[Rule]", "2"}], ",",
   RowBox[{"\<\"Symmetric shrinking coefficient\"\>", "\[Rule]",
    "0.5555555588576793`"}], ",",
   RowBox[{"\<\"Exact expected coefficient\"\>", "\[Rule]",
    FractionBox["5", "9"]}], ",",
   RowBox[{"\<\"Single-clone pure-state fidelity\"\>", "\[Rule]",
    FractionBox["7", "9"]}], ",",
   RowBox[{"\<\"Exact block check\"\>", "\[Rule]", "True"}], ",",
   RowBox[{"\<\"Symmetry check\"\>", "\[Rule]", "True"}], ",",
   RowBox[{"\<\"Boundary witness checked\"\>", "\[Rule]", "True"}], ",",
   RowBox[{"\<\"Boundary feasible\"\>", "\[Rule]", "True"}], ",",
   RowBox[{"\<\"Outside point infeasible\"\>", "\[Rule]", "True"}]}],
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"e733c747-430e-4be1-929d-\
b32622c6ad12"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Optional feasible-region plots", "Section",ExpressionUUID->"fb57cc79-7c0d-4d77-b719-ae61d49ac635"],

Cell["\<\
Set makePlots = True in the parameter cell and reevaluate. These plots call \
an SDP solver at each sample and can take several minutes. Each coordinate is \
a shrinking coefficient. The single-clone physical interval is \[Minus]1/(d\
\.b2 \[Minus] 1) \[LessEqual] p\:1d62 \[LessEqual] 1. Feasibility tolerances \
can affect the displayed boundary. A point is accepted only if its primal \
witness satisfies positivity, trace normalization and all three marginal \
constraints to feasibilityTolerance = 10\:207b\:2077. Unknown or inaccurate \
solves are excluded. These coarse previews use no adaptive subdivision; \
increase PlotPoints and MaxRecursion for a finer boundary. Repeated \
partial-success warnings are counted in the plot diagnostics; their returned \
witnesses must still pass every check. Other unexpected solver diagnostics \
remain visible.\
\>", "Text",ExpressionUUID->"7de3719f-d5a3-4cf3-8d79-5fbec856a328"],

Cell["\<\
If[makePlots,
  Clear[plotFeasibleQ];
  plotAcceptedCount = plotInfeasibleCount = plotUncertainCount = 0;
  plotPartialSuccessCount = 0;
  plotFeasibleQ[x_?NumericQ, y_?NumericQ, z_?NumericQ] :=
    plotFeasibleQ[x, y, z] = Module[{result},
      Quiet[Check[result = cloneFeasibility[{x, y, z}],
        plotPartialSuccessCount++, SemidefiniteOptimization::parsuc],
        SemidefiniteOptimization::parsuc];
      Which[result === 0, plotAcceptedCount++,
        result === Infinity, plotInfeasibleCount++,
        True, plotUncertainCount++];
      TrueQ[result == 0]
    ];
  lowerShrinkage = -1/(d^2 - 1);
  region3D = RegionPlot3D[plotFeasibleQ[x, y, z],
    {x, lowerShrinkage, 1}, {y, lowerShrinkage, 1}, {z, lowerShrinkage, 1},
    AxesLabel -> {\"p\:2081\", \"p\:2082\", \"p\:2083\"}, PlotPoints -> 8, \
MaxRecursion -> 0,
    Mesh -> None, PlotLabel -> Row[{\"1 \[RightArrow] 3 cloning, d = \", \
d}]];
  zeroSlice = RegionPlot[plotFeasibleQ[x, y, 0],
    {x, lowerShrinkage, 1}, {y, lowerShrinkage, 1},
    FrameLabel -> {\"p\:2081\", \"p\:2082\"}, PlotLabel -> \"Slice p\:2083 = \
0\",
      PlotPoints -> 16, MaxRecursion -> 0];
  plotDiagnostics = Association[
    \"Accepted witness checks\" -> plotAcceptedCount,
    \"Infeasible samples\" -> plotInfeasibleCount,
    \"Unresolved samples excluded\" -> plotUncertainCount,
    \"Partial-success solves\" -> plotPartialSuccessCount];
  Column[{region3D, zeroSlice, plotDiagnostics}],
  \"Plots skipped; set makePlots = True to generate them.\"]\
\>", "Input",
 CellTags->
  "app3-plots",ExpressionUUID->"1d02825d-9e66-43a6-8d48-7ff1c1e44d7d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Optional reduced qubit formulation", "Section",ExpressionUUID->"cde053b4-b026-4222-9b37-1940f04a59fe"],

Cell["\<\
This independent small-matrix formulation is specific to d = 2 and reproduces \
equations (161)\[Dash](164). Eliminate the nonnegative scalar block X\:2081, \
set \[Beta] = 2 X\:2082 and \[Gamma] = 6 X\:2083, and use symmetric real 2 \
\[Times] 2 and 3 \[Times] 3 matrices. The remaining trace budget is Tr \
\[Beta] + Tr \[Gamma] \[LessEqual] 4. All three coefficients below are \
ordered (p\:2081, p\:2082, p\:2083).\
\>", "Text",ExpressionUUID->"86d446d7-25c4-4a37-97aa-e6e01fea6e6b"],

Cell["\<\
betaMatrix = {{beta[1], beta[2]}, {beta[2], beta[3]}};
gammaMatrix = {{gamma[1], gamma[2], gamma[3]},
  {gamma[2], gamma[4], gamma[5]}, {gamma[3], gamma[5], gamma[6]}};
qubitShrinking = {
  -1/3 + (beta[3] + gamma[6])/3,
  -1/3 + (3 beta[1] + 2 Sqrt[3] beta[2] + beta[3] + 3 gamma[4] +
    2 Sqrt[3] gamma[5] + gamma[6])/12,
  -1/3 + (9 beta[1] - 6 Sqrt[3] beta[2] + 3 beta[3] + 8 gamma[1] +
    4 Sqrt[2] gamma[2] + 4 Sqrt[6] gamma[3] + gamma[4] +
      2 Sqrt[3] gamma[5] + 3 gamma[6])/36};
qubitConstraints = {VectorGreaterEqual[{betaMatrix, 0},
  {\"SemidefiniteCone\", 2}],
  VectorGreaterEqual[{gammaMatrix, 0}, {\"SemidefiniteCone\", 3}],
  Tr[betaMatrix] + Tr[gammaMatrix] <= 4};
qubitVariables = Join[Array[beta, 3], Array[gamma, 6]];
qubitRadialMaximum[direction_List] := SemidefiniteOptimization[-radialScale,
  Join[qubitConstraints, Thread[qubitShrinking == radialScale direction]],
  Prepend[qubitVariables, radialScale], \"PrimalMinimumValue\"] * (-1);
If[runAnalyticExamples && d == 2,
  qubitSymmetricCoefficient = qubitRadialMaximum[{1, 1, 1}];
  require[Abs[qubitSymmetricCoefficient - 5/9] < 10^-7,
    \"the reduced qubit formulation must give 5/9\"];
  Association[\"Reduced qubit symmetric coefficient\" ->
    qubitSymmetricCoefficient],
  \"Reduced qubit solve skipped; enable runAnalyticExamples for d = 2.\"]\
\>", "Input",
 CellTags->
  "app3-qubit-analytic",ExpressionUUID->"70a8b9c8-5ec9-46eb-b1ca-\
43b5a11b373b"],

Cell["\<\
For further analytic work, the equivalent principal-minor inequalities and \
the rotation used to view the region along its symmetry axis are defined \
below. These definitions do not launch symbolic elimination or local \
nonlinear optimization during a normal run.\
\>", "Text",ExpressionUUID->"440b2368-ca23-463f-9388-5bcd739f20e7"],

Cell["\<\
qubitPrincipalMinors = Join[
  {beta[1], beta[3], Det[betaMatrix]},
  {gamma[1], gamma[4], gamma[6],
   Det[gammaMatrix[[{1, 2}, {1, 2}]]], Det[gammaMatrix[[{1, 3}, {1, 3}]]],
   Det[gammaMatrix[[{2, 3}, {2, 3}]]], Det[gammaMatrix]}];
qubitPolynomialConstraints = Join[{Tr[betaMatrix] + Tr[gammaMatrix] <= 4},
  Thread[qubitPrincipalMinors >= 0]];
symmetryAxisRotation = RotationMatrix[ArcCos[1/Sqrt[3]], {1, 0, 0}].
  RotationMatrix[Pi/4, {0, 0, 1}];
rotatedQubitShrinking = Simplify[symmetryAxisRotation.qubitShrinking];\
\>", "Input",
 CellTags->
  "app3-qubit-geometry",ExpressionUUID->"336ce7a5-b4ea-4a98-b37b-\
59c927d34d02"]
}, Open  ]]
}, Open  ]]
},
